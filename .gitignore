/music_tabs.inc
/snd_pitch.inc
/sound_tables.inc
/weap_tables.inc
/wi_syms.inc
/wi_tables.inc

# wadconv's remembered paths (IWAD / PWAD / emulator -- local to each machine)
build/py/wad/wadconv.json

# python
__pycache__/
*.pyc

# scratch test/debug scripts
/tools/tests/

# backups / scratch
*.bak
*.tmp
/bench/
/sram/

