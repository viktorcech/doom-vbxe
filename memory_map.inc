; ---- the END-OF-EPISODE FINALE (f_finale.c, f_finale.asm) -------------------
; An ExM8 shows the episode's story text and its end picture INSTEAD of the
; intermission (pack_map.py bakes "this level ends episode n" into the level
; header as MAP_HFINEP, because the engine has no episode number). The shape is
; wi.asm's, part for part: one resident stub, a bootstrap overlay at MENU_RUN
; and the bulk in the map slot -- see the f_finale.asm header.
FINEXIT_BASE equ $E6A0               ; fin_exit: main's EXIT_REQ tail, in FRONT
FINEXIT_END  equ $E6F7               ;   of wi_exit's stub (which it jumps to for
                                     ;   every ordinary exit). Under the ROM, and
                                     ;   that is fine: the frame loop that calls
                                     ;   it runs with the ROM banked OUT, exactly
                                     ;   as update_door30 did before it moved out
                                     ;   of this same block on 2026-08-18.
FINOVL_STAGE equ $9000               ; where MADS parks STAGE 1 -- the MEMAC
                                     ;   window's own address space, which is
                                     ;   RESERVED (tools/ram_map.py) and so
                                     ;   carries no XEX segment of any kind. The
                                     ;   other four overlays park in the THINGS
                                     ;   slot and the map HIGH region for the
                                     ;   same reason; those two are full.
                                     ;   split_menu_ovl.py lifts the block out
                                     ;   before check_xex.py ever sees it.
FIN2_RUN     equ $4100               ; STAGE 2 runs where wi.asm's does, and it
FIN2_END     equ $4BFF               ;   can: the intermission and the finale are
FIN2_PAGES   equ 11                  ;   the two halves of one `if`, never both
                                     ;   live. Unlike wi.asm's it is PARKED
FIN2_STAGE   equ $9500               ;   elsewhere -- two segments at $4100 is an
                                     ;   ambiguity split_menu_ovl.py resolves by
                                     ;   start address, so the finale's gets one
                                     ;   of its own behind stage 1's 1280 B.
    .if FIN2_RUN != WI2_RUN || FIN2_END != WI2_END || FIN2_PAGES != WI2_PAGES
        ert 'FIN2_RUN/END/PAGES must track WI2_* -- both stage 2s share the slot'
    .endif
    .if FIN2_STAGE < FINOVL_STAGE + [MENU_RUN_END+1-MENU_RUN]
        ert 'FIN2_STAGE overlaps the parked STAGE 1 (FINOVL_STAGE + 1280 B)'
    .endif
FIN2_RESUME equ FIN2_RUN+3           ; stage 2's SECOND entry, the jmp right
                                     ;   behind fin_main's: where fin_esc comes
                                     ;   back when the control panel was only
                                     ;   closed. It is an address and not a
                                     ;   label because the caller is resident
                                     ;   code and the callee is in an overlay.
                                     ;   (There is no FIN_XLOAD twin of wi.asm's
                                     ;   across-the-load driver: a DOOM 1 finale
                                     ;   loads no level, so nothing of the
                                     ;   finale ever has to outlive TEX_STAGE.)
FIN_ARENA   equ $018000              ; the stage-1 PAGES stream in HERE, into the
FIN_ARBANK  equ $18                  ;   texture/sprite pool -- 88 KB of it for
                                     ;   episode 3 (both bunny pages and the END
                                     ;   letters). Legal for mn_readthis' reason:
                                     ;   the pool holds the LEVEL's graphics, the
                                     ;   level is over, and exit_level streams the
                                     ;   next one's over the top on the way out.
