AIWS_BASE   equ $0CA1                ; ai_wseen: ai_wake's middle-column test, in
AIWS_END    equ $0CC1                ;   the same free hole sg_bsp took the top of.
                                     ;   $0CC1 and NOT a byte further: ANVARS
                                     ;   starts at $0CC2 and the idle-ring tick
                                     ;   WRITES it every DOOM tic. The old $0CD4
                                     ;   was a lie the guard could not catch --
                                     ;   11 bytes of growth here (2026-08-07) put
                                     ;   a jsr under an_i[], the ring overwrote
