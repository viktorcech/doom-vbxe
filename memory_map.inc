SPRNCUT_BASE equ $B7F2               ; spr_ncut: the sprite side of the same test,
SPRNCUT_END  equ $B80F               ;   in the 30 B between mv_ptr and hud_blit
SEGSCL_BASE equ $BCA1                ; seg_scl: rs_sscl = min(scL, scR), once per
