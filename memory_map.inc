; ---- the $FE1D-$FFF9 hole, split in two ------------------------------------
;   spr_pickup MOVED here (2026-07-30): the $B000 sprites segment ended at $B7C0
;   against textures.asm's org at $B7C1, so the 5-byte vs_th store in spr_add had
;   nowhere to go. spr_pickup is the right thing to move -- once per frame, one
;   absolute jsr from the main loop, nothing falls through into it.
PICKUP_BASE equ $FE1D
PICKUP_END  equ $FEDC                ; 192 B
ENEMY_BASE  equ $FEDD                ; en_gunshot / en_shoot -- the HOT half
ENEMY_END   equ $FFE9                ; 269 B. NOT $FFF9 (2026-08-11, the plasma
                                     ;   freeze): $FFFA is where the EMULATION
                                     ;   vectors start, but this port runs the
                                     ;   65816 in NATIVE mode and urom_init
                                     ;   (underrom.asm) fills the native pair
                                     ;   too -- NMI at $FFEA/$FFEB, IRQ at
                                     ;   $FFEE/$FFEF. en_plasma's tail sat on
                                     ;   $FFEA, so every boot overwrote the high
                                     ;   byte of its `jmp en_plasma2` with
                                     ;   <rom_nmi ($A8) and the first plasma shot
                                     ;   jumped to $A847 -- unloaded RAM, instant
                                     ;   hang. $FFE4-$FFEF is the whole native
                                     ;   vector table: no code may live there.
ENINIT_BASE equ $EEAE                ; en_init + the enemy.asm variables: cold (one
ENINIT_END  equ $EFFF                ;   call per level) and it did not fit above --
                                     ;   the $FEDD block overflowed into $FFFA and
                                     ;   MADS reported it as an addressing error on
                                     ;   the first variable, not as an overrun.
vs_sid      = $BFA0                  ; [40] sprite table index
vs_ord      = $BFC8                  ; [40] draw order, NEAR..FAR (insertion-sorted
                                     ;      on scale; spr_draw walks it backwards)
                                     ;      ($BFF0-$BFFF spare)
; sprite render scratch -- free RAM behind the collision block ($0E9E-$0EFF)
sp_n        = $0E9E                  ; vissprites collected this frame
sp_i        = $0E9F                  ; thing loop index / range end
sp_last     = $0EA0
sp_cnt      = $0EA1                  ; snapshot column counter
sp_w        = $0EA2                  ; sprite width / height / offsets
sp_h        = $0EA3
sp_left     = $0EA4
sp_top      = $0EA5
sp_scale    = $0EA6                  ; Q8 vertical scale
sp_hs       = $0EA8                  ; Q8 horizontal scale (= vertical/2)
sp_x1       = $0EAA                  ; screen x of texture column 0 (signed)
sp_xa       = $0EAC
sp_xb       = $0EAD
sp_ytop     = $0EAE                  ; screen rows of the sprite's top/bottom
sp_ybot     = $0EB0
sp_rows     = $0EB2                  ; on-screen height
sp_addr     = $0EB4                  ; sprite pixels, VRAM base (24b)
sp_s        = $0EB7                  ; vertical oversampling factor (1 = raw)
sp_spy      = $0EB8                  ; SRC_STEPY (samples per screen row)
sp_ustep    = $0EBA                  ; texels per screen column (Q8)
sp_uacc     = $0EBC                  ; texel accumulator (Q8)
sp_col      = $0EBE                  ; current screen column
sp_lastx    = $0EBF                  ; source column currently in the scratch
sp_t        = $0EC0                  ; clip window for this column
sp_b        = $0EC1
sp_y0       = $0EC2                  ; clipped span
sp_y1       = $0EC3
sp_soff     = $0EC4                  ; source offset in samples
sp_oi       = $0EC6                  ; spr_draw: cursor into vs_ord (walked backwards)
sp_cstep    = $0EC7                  ; clip pointer advance per column (0 = uniform)
sp_uni      = $0EC8                  ; snapshot: every column's window still equal?
sp_cbase    = $0EC9                  ; this sprite's clip block (lo; the pool is a page)
;           $0ED0                  ; FREE (1 B): was sp_zsh, log2(ZOOM_Y). The
                                     ;   sprite blit has emitted exactly one dest
                                     ;   row per source read since 2026-08-04, so
                                     ;   spr_one wrote 0 here and the four readers
                                     ;   all took the z = 1 branch (spr_draw.asm).
sp_q        = $0ED1                  ; source reads skipped by the top clip
sp_bh       = $0ED3                  ; BCB HEIGHT for this column (reads - 1)
sp_t0       = $0ED4                  ; first column's window, for the uniform test
sp_b0       = $0ED5
th_ss       = $0ECA                  ; blob pointers, cached by load_things
th_things   = $0ECC
th_sprtab   = $0ECE
; $0ED6 FREE (1 B): sp_fuzz, the drawn sprite's MF_SHADOW flag. Dead since
;   2026-08-16 -- spr_shadow now writes the spectre's blit mode straight into
;   the sprite BCB, so nothing has to remember it per column.
; ---- T4 column crop (2026-08-03, docs/VRAM-PLAN.md A1) ----------------------
;   Contract: tools/_verify_sprcrop.py. The .spr blob stores every column
;   cropped to [first..last] opaque texel; the per-frame column table lives in
;   bank $01 (SPRCOL_EXT) and spr_ctcol/spr_cspan (spr_draw.asm, SPRCROP block)
;   turn it into the source address and the capped span.
sp_ctab     = $0ED7                  ; this frame's coltab (bank $01 addr);
                                     ;   spr_fget reads it out of the FTAB
sp_ctop     = $0ED9                  ; current column's crop: first stored texel
sp_clen     = $0EDA                  ;   ...and how many (0 = never blit)
sp_csmp     = $0EDB                  ; sp_ctop * S, in samples (16b)
; ---- B1 sprite arena (spr_fget/spr_fcopy, contract tools/_verify_arena.py) --
sp_fid      = $0EDD                  ; the frame id being resolved
sf_off      = $0EDE                  ; FTAB: file offset (u24)
sf_size     = $0EE1                  ; FTAB: stored bytes (u16; the copy eats it)
sf_ent      = $0EE3                  ; &FARENA[id] (bank $01), so the flush
                                     ;   path does not recompute it
sf_bank     = $0EE5                  ; MEMAC bank the copy window sits on
ar_base     = $0EE6                  ; arena floor (u24): $018000 + texch*4K,
                                     ;   set per level by arena_init
ar_bump     = $0EE9                  ; first free arena byte (u24)
spr_sdram   = $0EEC                  ; this level's .spr in SDRAM (u24,
                                     ;   LVL_SPRSD -- atr_levels.inc)
tex_flat    = $0EEF                  ; 'T' key: 1 = draw every wall flat (the
                                     ;   fast frame; seg_draw's resolve takes
                                     ;   the dominant-colour path). Boot = 0.
; $0EF0-$0EF2 FREE (3 B): the old tx_bump (B2 texture-arena top), deleted with
;   tex_fget 2026-08-14.
tex_sdram   = $0EF3                  ; this level's .tex in SDRAM (u24,
                                     ;   LVL_TEXSD -- atr_levels.inc). STILL
                                     ;   LIVE: seg_draw's wall/lower resolve and
                                     ;   texcol's index read add the file offset
                                     ;   to it (the painted path's whole address
                                     ;   calculation).
sf_src      = $0EF6                  ; spr_fcopy's SDRAM source (u24): spr_fget
                                     ;   computes it as spr_sdram + file offset
; $0EF9-$0EFB FREE (3 B): the old tx_flushed + tx_ncols, deleted with tex_fget
;   2026-08-14.
ld_drain    = $0EFC                  ; the tee-drain sector countdown (u16).
                                     ;   NOT m_a: read_sectors' SDRAM tee does
                                     ;   its address math in m_* -- counting
                                     ;   there read 64k sectors at boot
; ---- hu_stuff.c's MESSAGE widget (w_message): the line across the TOP --------
;   player->message is a char* in DOOM and a strip INDEX here -- the text was
;   rasterised at pack time (tools/pack_menu.py), so "the message" is one byte.
;   msg_t counts VBLANKs like every other timer in the port (the face, the
;   doors, the lifts), NOT frames: HU_MSGTIMEOUT is 4 seconds of wall clock at
;   5 fps and at 50.
;   THE ADDRESS IS NOT ARBITRARY. msg_t is PW_INVIS-1 so that pw_level's
;   existing `sta PW_INVIS-1,x` loop clears it for free on every level load,
;   boot included -- G_DoLoadLevel's "player->message = NULL" for no bytes at
;   all, in a block that was full to the byte (see powerups.asm).
msg_i       = $0EFE                  ; strip index of the message showing now
                                     ;   (bonus id + MSG_IDX0, menu_syms.inc)
msg_t       = $0EFF                  ; VBLANKs it still has; 0 = nothing shown
MSG_VB      equ 200                  ; HU_MSGTIMEOUT = 4*TICRATE = 4 s @ 50 Hz

; ---- doors: per-map tables DERIVED from MAP_DOORS, built once by init_doors ---
;   Constants for the whole level, hoisted out of the .bin (they used to be
;   recomputed per frame/per USE probe). They live in the DOOR_EXT block with
;   the state arrays (see DOOR_STATE above): same stride, same bank $01, so
;   they are read with the same long addressing.
DOOR_SECL   = DOOR_WAIT+DOORS_NMAX   ; [N] &MAP_SECTORS[door_sec], lo
DOOR_SECH   = DOOR_SECL+DOORS_NMAX   ; [N]                         hi
DOOR_OPNL   = DOOR_SECH+DOORS_NMAX   ; [N] open_ceil (i16), lo
DOOR_OPNH   = DOOR_OPNL+DOORS_NMAX   ; [N]                  hi
DOOR_SIDL   = DOOR_OPNH+DOORS_NMAX   ; [N] door sector id -- a BYTE: the biggest
                                     ;   episode-1 map is 250 sectors and
                                     ;   SEG_FRONT/SEG_BACK are bytes anyway, so
                                     ;   the .bin's u16 sector field always had a
                                     ;   zero high byte and door_index_of never
                                     ;   needed the second compare
DOOR_DENY   = DOOR_SIDL+DOORS_NMAX   ; [N] THE SIDE RULE: the sector a USE press
                                     ;   must be REFUSED from ($FF = none). A
                                     ;   manual door opens from the FRONT sector
                                     ;   of the line carrying the special
                                     ;   (p_switch.c P_UseSpecialLine returns
                                     ;   false for side 1); the same door's other
                                     ;   face carries special 0 and answers "oof".
                                     ;   The engine has no linedef specials, so
                                     ;   pack_map names that face's sector here
                                     ;   -- in the high byte the sector id left
                                     ;   free, so this table costs no RAM. 16
                                     ;   doors in episode 1 have that shape, E1M2's
                                     ;   secret at (1516,904) among them
DOOR_FRAC   = DOOR_DENY+DOORS_NMAX   ; [N] Q8 remainder of the VBLANK-scaled move
DOOR_RAMEND = DOOR_FRAC+DOORS_NMAX   ; + DOORSTAY below = the 12th array. The
                                     ; whole chain must stay inside DOOR_EXT's
                                     ; kilobyte -- doors.asm asserts it.

;==============================================================
; VBXE 24-bit VRAM MAP  (2026-08-03: the VRAM diet -- see _navrh_vram.txt)
;--------------------------------------------------------------
;  $000000  FRAME_A   view rows 0-167; rows 168-199 ($006900-$007CFF) are the
;                     SHARED status bar: BOTH XDLs point their bottom 32 lines
;                     here, so the bar is painted ONCE (hud_dirty = 1, not 2)
;  $008000  free      2 chunks (old weapon region)
;  $00A000  OVERHEAD  (bank $0A): XDL + BCB control blocks
;  $00B000  MENUPATCH the M_DOOM banner, MainMenu[]'s six lines and the two
;                     skull frames (3 chunks, tools/pack_menu.py). FIXED, not
;                     pooled: the ESC menu has to draw them mid-level, and the
;                     title picture's home at $018000 is the sprite arena by
;                     then. $00D500-$00DFFF is the slack in the last chunk.
;  $00E000  MENUOVL   the menu CODE overlay (1 chunk; menu.asm runs it from
;                     $1000, mn_open copies it down). $00F000 is free.
;  $010000  FRAME_B   the other back buffer, view rows only -- its bar area
;                     $016900-$017FFF is dead (the XDL never reads it), which is
;                     what lets the melt borrow the whole thing as WIPE_END: a
;                     FULL 200-row screen fits, and no frame is rendered while a
;                     wipe runs
;  $018000  POOL      textures + sprites, per level (make_atr_doom.py
;                     atr_levels.inc): the level's .tex streams to $018000+,
;                     its .spr starts at the next 4 KB chunk after it, and
;                     everything up to ARENA_SPR_TOP ($03D000, 148 KB) is one
;                     shared pool. Fixed 212/128 KB slots died 2026-08-03 -- a
;                     level with small textures now spends the difference on
;                     walk/attack frames (pack_things sizes the cycle to what
;                     is left).
;                     Only doors/lifts/switches are textured: docs/TEXTURES-OFF.md
;  $040000  HU STRIPS every line of TEXT the engine shows, rasterised at pack
;                     time: nine automap level names, then one pickup message
;                     per bonus id. 40 x 1 KB, streamed once at boot. This is
;                     ABOVE the pool's ceiling on purpose -- a level's sprites
;                     would otherwise walk over it (pack_menu.py, strip_blit).
;  $04F000  WI + FIN  the INTERMISSION's patches (tools/pack_wi.py) and then, in
;                     the same consecutive bank run, four CODE overlay chunks
;                     (wi.asm's two stages, f_finale.asm's two) and the FINALE's
;                     resident assets -- hu_font, the three finale flats and the
;                     three story texts (tools/pack_fin.py). 24 chunks, and BOTH
;                     ends of the run are computed: WI_VRAM sits behind the HU
;                     strips, whose count is the level set's. It ends at $066FFF
;                     today. The finale's four PAGES are NOT here -- they are
;                     32 KB each and stream into the pool on demand (FIN_ARENA).
;  $067000  WIPE_START the melt's "picture being taken away" (see the MELT block
;                     below). It has to survive a level load, so it lives above
;                     everything the boot stream owns and below FRAME_C.
;  $070000  FRAME_C   the third framebuffer, VIEW rows only (2026-08-11 triple
;                     buffer, $6900 B; the bar rows are shared in bank 0).
;                     TEX8 moved to $00F800, the rest of bank 7 repacked:
;  $077000  WEAP_SLOT the ACTIVE weapon's psprite frames, 6 chunks (24 KB;
;                     the shotgun's 21,203 B is the ceiling). The full 76 KB
;                     set lives in Rapidus SRAM (WEAP_EXT $04:0000, loaded at
;                     boot); wp_wload copies one weapon's run in on a switch
;                     (~15 ms, hidden inside the raise animation).
;  $07D000  HUD       status bar graphics (pack_hud.py), 12 KB to the VRAM top
;==============================================================
;  The weapon REGIONS are gone (2026-08-03): the six scattered holes they
;  filled went back to the map above -- $04D000 merged the texture slot into
;  the pool, $071000-$076FFF is the active-weapon slot, and $008000/$00B000/
;  $077000/$07C000 (44 KB) are FREE for future fixed assets. pack_weap.py owns
;  WEAP_SLOT/WEAP_EXT (weap_tables.inc), make_atr_doom.py asserts per level
;  that tex+spr fit the pool.
VRAM_SCREEN     equ $000000          ; FRAME_A, 160x200 = $7D00 B
FRAME_B         equ $010000          ; buffers 2 + 3 of the TRIPLE buffer
FRAME_C         equ $070000          ;   (2026-08-11): three frames = the flip
FRAME_C_BANK    equ $07              ;   needs NO VBLANK wait -- publish XDLA any
                                     ;   time, VBXE latches it at frame start
                                     ;   (alt-src vbxe.cpp mXdlAddr=mXdlBaseAddr)
                                     ;   and the new back buffer is never the one
                                     ;   still being scanned. FRAME_C holds only
                                     ;   the VIEW rows 0-167 ($6900 B): the bar
                                     ;   rows are shared in bank 0 like FRAME_B's.
                                     ;   zback_hi walks $00 -> $01 -> $07 (znext
                                     ;   in swap_buffers); every blit DST stamp
                                     ;   takes the value as the bank byte, so
                                     ;   nothing but the flip machinery changed.
ZFRONT          equ $06EC            ; the buffer the last flip PUBLISHED (= what
                                     ;   the screen shows/will show) -- mn_freeze
                                     ;   needs it now that "shown" is no longer
                                     ;   zback_hi^1. In door_index_of's slack.
FRM_PAR         equ $06ED            ; frame parity 0/1. It was the spectre fuzz
                                     ;   checkerboard's (zback_hi was the parity
                                     ;   while it toggled 0/1); that effect is
                                     ;   gone 2026-08-16 and nothing but
                                     ;   swap_buffers and _dbg_xdl3.py reads it
XDLTAB_BASE     equ $06EE            ; xdl_hi + znext, the two 8-entry flip maps
                                     ;   (bsp_main_player.asm), $06EE-$06FD --
                                     ;   the rest of door_index_of's slack
BLITW_BASE      equ $27EF            ; blitw_hard: the gap-proof blitter wait
BLITW_END       equ $27FF            ;   (BUSY must read 0 four times in a row;
                                     ;   the single-read wait let the flip race
