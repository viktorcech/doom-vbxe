; ---- BLIT CHAINS (2026-07-28, repurposed for the PAINTER 2026-08-10) ---------
;   Chained BCBs (CTRL bit3 = another BCB follows at +21, vbxe.cpp LoadBlitter)
;   in one of TWO buffers, fired with ONE start. The CPU builds chain N+1 while
;   the blitter walks chain N -- two buffers because chained BCBs are fetched
;   from VRAM as the blitter reaches them: the running chain must stay intact.
;   With TEX_RUNS every span the frame draws -- painted wall runs AND the
;   ceiling/floor flats, all 1-px vline fills -- is emitted as a link (pt_span,
;   paint.asm) instead of its own submit: ~4000 submits/frame collapse into
;   ~100 fires (ptc_fire, textures.asm). Slot 0 of each buffer stays the 8x
;   expander's (sprite path, tw_expand); the painter owns slots 1..47.
;   Each slot's DST bank byte must equal zback_hi: a 2-BCB chain built by
;   setup_chains and fired once per frame by ptc_frame stamps all 94 of them
;   (dst step 21 walks the slot array) -- no CPU loop through the slow window.
;   48 slots x 21 B = 1008 B per buffer; both fit the overhead bank page-aligned
;   (page-aligned so tw_chn can carry just the window PAGE, $97 <-> $9B).
VRAM_BCB_CHA    equ $00A700          ; chain buffer A ($700-$AEF in the window)
VRAM_BCB_CHB    equ $00AB00          ; chain buffer B ($B00-$EEF in the window)
TW_MAXLINKS     equ 48
PT_LINKS        equ TW_MAXLINKS-1    ; painter links per chain (slot 0 is not ours)
TWCHAIN_BASE    equ $2747            ; ptc_fire/ptc_open (chain terminate + launch;
TWCHAIN_END     equ $278F            ;   tw_chain_open/fire when !TEX_RUNS)
SETCHN_BASE     equ $4B18            ; setup_chains (boot-only!): parked in the
SETCHN_END      equ $4BFF            ;   staged $4000-$4BFF area behind the menu
                                     ;   loaders -- it runs from setup_bcbs, long
                                     ;   before the first load_level stream kills
                                     ;   the region. Its old $BC10 home is
                                     ;   PTCFRAME_BASE now (per-frame code).
WALKINIT_BASE   equ $8AAD            ; walk_init: zero rs_mpass, then fall on
WALKINIT_END    equ $8AB4            ;   into ptc_frame. rs_mpass ($131A) is
                                     ;   INSIDE the $1000-$14FF overlay window,
                                     ;   so every overlay that runs (the automap
                                     ;   leaves $AD there -- `lda am_dx+1`) hands
                                     ;   the NEXT walk a non-zero masked-pass
                                     ;   flag: mtx_occ then re-opens every seg's
                                     ;   columns through mseg_prime, the "all
                                     ;   solid -> drop the seg" cull never fires
                                     ;   and am_mark lights up the whole map.
                                     ;   mseg_draw's early-out zeroes it at the
                                     ;   END of that same render_world, one frame
                                     ;   too late. This runs at the START instead;
                                     ;   render_world's `jsr ptc_frame` is
                                     ;   RETARGETED here, so that segment (one
                                     ;   byte below load_dtab) pays nothing.
TRIGEXIT_BASE   equ $8AB5            ; trig_exit: P_CrossSpecialLine's W1 exit
TRIGEXIT_END    equ $8AD0            ;   cases (52/124), in front of trig_walk.
SMUL14_BASE     equ $8AD1            ; smul_14: evicted from the $2000 engine
SMUL14_END      equ $8B43            ;   segment so step_recip could grow its
                                     ;   saturation test (math.asm) -- that
                                     ;   segment ends where process_seg ends and
                                     ;   sg_tgt starts ($3B72), with nothing
                                     ;   between them. smul_14 is the cheapest
                                     ;   thing in there to move out: move_player,
                                     ;   the doors' thrust, powerups and proj call
                                     ;   it a handful of times a frame, never per
                                     ;   seg and never per column, so win2's
                                     ;   slower fetch costs nothing measurable.
                                     ;   (The frame's OWN transform does not use
                                     ;   it at all -- fmul_sin/fmul_cos replaced
                                     ;   it there, tips #4.)
                                     ;   Behind walk_init in the same free hole;
                                     ;   TRIGW ($E580) has none left.
PTCFRAME_BASE   equ $BC14            ; ptc_frame: per-frame chain-slot zback stamp
                                     ;   MOVED UP 4 B 2026-08-28: coll_seg needed them
                                     ;   for the shut-door test, and ptc_frame's own
                                     ;   run ($BC10-$BC2A) had 7 spare below END.
PTCFRAME_END    equ $BC32            ;   (real end at $BC32, PTCSTAMP/PTCGO moved)
PTCSTAMP_BASE   equ $B568            ; ptc_stamp: stamp zback_hi into chain slots
PTCSTAMP_END    equ $B580            ;   (free RAM hole above sprites)
PTCGO_BASE      equ $B581            ; ptc_go: fire blitter chain
PTCGO_END       equ $B5A0            ;   (free RAM hole above sprites)
SPREXP_BASE     equ $AF34            ; tw_expand_spr (the 12 B after collision)
SPREXP_END      equ $AF3F

; ---- 8x-oversampled column scratch ------------------------------------------
;   SRC_STEPY is an INTEGER byte step, so sampling the raw texture can only give
;   rates of 1,2,3.. texels/row (SRC_STEPY) or 1,1/2,1/3.. (ZOOMY) -- nothing in
;   between. That ladder is what made wall textures slide vertically while
;   walking: between two rungs the texture keeps a FIXED on-screen size while the
;   wall itself grows. Fix: blit the wanted column into a scratch expanded 8x
;   vertically (ZOOMY=8), then sample THAT with SRC_STEPY = round(tpr*8) -> the
;   rate ladder gets 8x finer (1/8 texel per row) and one blit still covers the
;   whole run. Costs texH*8 <= 1024 B of VRAM + one extra blit per column.
VRAM_TEX8       equ $00F800          ; 2026-08-11: moved out of $070000 -- bank
                                     ;   $07 is FRAME_C now. Lives in the sg
                                     ;   overlay chunk's PADDING: the boot menu
                                     ;   stream overwrites it, which a per-column
                                     ;   SCRATCH does not mind (nothing LIVES
                                     ;   here between expand and sample).
VRAM_TEX8B      equ $00FC00          ; the SECOND scratch: an expand emitted into
                                     ;   chain N+1 must not overwrite the column
                                     ;   chain N is still reading, so the target
                                     ;   flips on every expand (tw_scr).
TEX8_ZOOM       equ 8                ; vertical oversampling factor

; ---- MEMAC-A window: 4 KB at MEMW in 6502 space; the map sits below it -------
MEMW            equ $9000
MEMW_HI         equ >MEMW            ; window position (high nibble) for MEMAC_CTL
BANK_OVERHEAD   equ $0A

;==============================================================
; SOUND (sound.asm, tools/wadsound.py) -- digitized DOOM SFX
;--------------------------------------------------------------
;   2026-07-31 -- THE SAMPLES ARE NOT IN VBXE ANY MORE. They never needed to be:
;   the Timer-1 IRQ reads them ONE BYTE AT A TIME with the CPU and the blitter
;   never touches them. Living in VRAM cost a MEMAC-B map/read/unmap per sample
;   AND a wait for the blitter to go idle (a VRAM read during a blit can return
;   garbage). In Rapidus bank $02 it is a single 65816 `lda.l` with nothing to
;   synchronise against -- and it handed 32 KB of VBXE VRAM back, which is what
;   the monsters' attack frames needed.
;   The 16 KB two-bank split went with it: that was the MEMAC-B window's
;   granularity, so the blob is one contiguous run now with room to grow (the
;   sight sounds, which had nowhere to go while a bank was the unit).
;==============================================================
SNDLD2_BASE     equ $8300            ; load_sounds + its region rows (sound.asm):
SNDLD2_END      equ $837F            ;   the multi-bank region loop (T5) outgrew
                                     ;   the packed $0400 block. Drives SIOV ->
                                     ;   below $C000; the seg table's old run.
SND_EXT         equ $020000          ; REGION 0's 24-bit base. Since 2026-08-03
                                     ;   (T5) the blob is MULTI-BANK: a voice
                                     ;   carries all THREE address bytes in
                                     ;   sv_al/ah/ab (sfx_lo/hi/bnk) and
                                     ;   snd_fetch feeds them to the one shared
                                     ;   `lda.l`, regions are
                                     ;   whole Rapidus banks (wadsound REGIONS:
                                     ;   $02 + $06; $07 kept free for RMT music)
                                     ;   and a sound never crosses a bank end --
                                     ;   the IRQ still increments only the low
                                     ;   two operand bytes. 128 KB of room.
; sound.asm code + tables. $0400-$05FF is dead RAM in this port: the cassette
; buffer ($0400-$047F), the user area ($0480-$057F) and CIO's line buffer
; (LBUFF, $0580-$05FF) all belong to OS services this port never invokes -- it
; boots from an ATR with no DOS, and touches neither cassette, nor the
; floating-point pack, nor CIO (grep: no CIOV call anywhere). It is also the only
; free CONTIGUOUS block left -- the three holes in the RAM-BUDGET above are
; 52/42/39 B and the IRQ player is ~400 B. The OS boot code DOES use $0400 for
; the boot sector, but that is long over by the time the XEX segments load.
SOUND_BASE      equ $0400
SOUND_END       equ $05FF            ; asserted at the end of sound.asm. $05FF and
                                     ; not $05A7 since 2026-08-18: snd_door_toggle
                                     ; reads DOOR_STATE, which went long with the
                                     ; DOOR_EXT move, and the one extra byte broke
                                     ; the old bound. $05A7 was just where the code
                                     ; happened to end -- the real ceiling is the
                                     ; top of LBUFF, per the note above.

;==============================================================
; $4C00-$85FF -- THE RAM THE SEG TABLE VACATED (2026-07-31)
;--------------------------------------------------------------
;   The packed seg records (MAP_NSEGS x 8 B = 14,896 B) used to sit at
;   $47F0-$821F inside the streamed map slot. They are pure data read through
;   one pointer, so they went to a Rapidus SRAM bank of their own (bank $03,
;   map_syms.inc MAP_SEG_BANK) and every reader became `[zp_sptr],y` instead of
;   `(zp_sptr),y` -- +1 cycle a read, ~5 K cycles a frame, and bank $01/$03 SRAM
;   is on the same fast bus as base RAM (Altirra rapidus.cpp SetLayerFastBus).
;   What is left of the LOW region is header + sectors + textab + yoffs, 2748 B,
;   so the streamed slot is $4000-$4BFF and everything above it is ordinary RAM.
;
;   WORTH KNOWING before you put per-column code here: per rapidus.cpp
;   kSRAMWindows, $4000-$7FFF is a real fast SRAM window (window 1, enabled when
;   MCR bit1 = 0 and PORTB bit4 is high -- this port never banks XE RAM), unlike
;   $8000-$BFFF, which can never be one because the MEMAC window sits at $9000.
;   That is UNVERIFIED on hardware: the map lived here for the whole project, so
;   nothing has ever been timed from these addresses. Treat $4C00-$7FFF as
;   probably-fast and $8000-$85FF as slow until someone bisects it.
DISKIO2_BASE    equ $B8C0            ; read_urom -- the SIO shell only since
DISKIO2_END     equ $B947            ;   2026-08-17: "load-time only, so win2
                                     ;   costs nothing" was FALSE for the byte
                                     ;   loops -- _prof_wi measured the level
                                     ;   transition paying ~2.4 s (first visit)
                                     ;   / ~0.9 s (SDRAM revisit) in win2
                                     ;   fetches, nearly all of it read_sectors'
                                     ;   per-sector loops. read_sectors moved to
                                     ;   DIOFAST (fast win1), read_urom's inner
                                     ;   copy to CP128; the shells stay, still
                                     ;   below $C000 -- they drive SIOV.
DISKIO2B_BASE   equ $ADE5            ; pre_map/load_textures/load_vram -- the
DISKIO2B_END    equ $AF3F            ;   second half, in cb_corners' old spot
                                     ;   (+ the 12 B collision spare behind it)
                                     ;   pre_map is the one hot-ish tenant left
                                     ;   (~40 win2 instr per sector, ~30 ms a
                                     ;   load) -- next eviction candidate if a
                                     ;   fast hole its size ever opens.
DIOFAST_BASE    equ $7D00            ; read_sectors + ld_src (2026-08-17): the
DIOFAST_END     equ $7DA9            ;   per-sector engine of EVERY load -- SIO
                                     ;   DCB + the SDRAM tee/copy loops, ~600
                                     ;   fetches per sector. In fast win1 the
                                     ;   whole load path drops from seconds to
                                     ;   tenths (bench/wi_prof.txt). This is
                                     ;   load_sprcol/load_sprites' old run, an
                                     ;   EXACT 170 B fit; they took the win2
                                     ;   hole read_sectors left (SPRCLD/SPRLD2).
CP128_BASE      equ $7C9E            ; cp128_ur (diskio.asm): read_urom's inner
CP128_END       equ $7CB2            ;   128 B staging->dest copy, jsr'd out of
                                     ;   the win2 shell into this fast crumb
                                     ;   (was free; spr_sidtab ends at $7C9D,
                                     ;   pj_burst starts at $7CB3).

