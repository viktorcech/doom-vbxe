;==============================================================
; PALETTE FLASH (weapon.asm's tail) -- st_stuff.c ST_doPaletteStuff
;--------------------------------------------------------------
;   DOOM tints the WHOLE screen red as you take damage and gold as you pick
;   something up, by swapping the installed palette: PLAYPAL is fourteen 768-byte
;   palettes and ST_doPaletteStuff picks one from two counters --
;     damagecount  += damage on every hit, capped at 100   (p_inter.c)
;     bonuscount   += BONUSADD (6) on every pickup         (p_inter.c)
;   both decremented once per TIC (p_user.c P_PlayerThink) -- then
;     cnt   -> palette (cnt+7)>>3, clamped to 7, + STARTREDPALS (1)
;     bonus -> palette (bonus+7)>>3, clamped to 3, + STARTBONUSPALS (9)
;   and I_SetPalette runs only when the chosen slot CHANGES.
;
;   The port does all of that with DOOM's own bytes and no upload at all: VBXE
;   holds FOUR palettes (VBXE_PSEL 0..3) and the XDL's overlay byte says which
;   one the picture uses, so a flash is ONE byte written into the XDL -- against
;   768 register writes (~3.4 ms) for a real I_SetPalette. The cost is that only
;   four of DOOM's fourteen slots fit, so its eight red levels collapse to two
;   (pack_textures.py PAL_SLOTS = 0, 2, 5, 10).
;
;   NOT ported: A_Light1/A_Light2 (the muzzle flash's extralight). In DOOM that
;   only shifts which COLORMAP row a wall picks -- r_segs.c
;   `lightnum = (sector->lightlevel >> LIGHTSEGSHIFT) + extralight` -- and this
;   renderer has no light diminishing at all: every wall is already drawn at
;   colormap 0, full bright. There is nothing for extralight to brighten, so the
;   two states are WA_NONE in the table and the gun flash stays the PISF/SHTF
;   sprite, exactly as bright as DOOM's.
;==============================================================
FLASH_BASE      equ $F71C            ; update_flash + the counters, right after
                                     ;   (was $F709: wp_fire_a's jsr en_gunshot
                                     ;   needed 3 B and the $F280 weapon segment
                                     ;   had none. The flash block is 110 B and
                                     ;   FLASH_END is $F7FF, so it had the room.)
FLASH_END       equ $F7FF            ;   weapon.asm in the same under-ROM block
FL_PAL_NORM     equ OV_PAL1          ; the VBXE palettes, in the order
FL_PAL_REDLO    equ OV_PAL2          ;   load_palette installs PAL_SLOTS into
FL_PAL_REDHI    equ OV_PAL2          ;   them (diskio.asm pld_psel).
FL_PAL_GOLD     equ OV_PAL3          ; 2026-08-01: PALETTE 0 IS NOT USED. It is
                                     ;   what VBXE maps plain GTIA colours
                                     ;   through and a warm reset does not
                                     ;   refill it, so writing it left a black
                                     ;   screen after RESET until a power cycle.
                                     ;   wolfenstein3d-vbxe avoids it for the
                                     ;   same reason (src/vbxe_init_cold.asm:70).
                                     ;   The price is one of DOOM's two damage
                                     ;   reds: REDLO and REDHI are the same
                                     ;   palette now, so FL_REDSPLIT below still
                                     ;   branches but both arms look alike.
;   The bits EVERY write of that XDL byte carries, flash or not: OV_NORMAL for the
;   320-pixel overlay, and PF_PAL1 for the PLAYFIELD -- the 8 hw pixels each side
;   and the bottom 40 rows that the overlay does not cover. VBXE looks the GTIA
;   background up in the palette PF_PALn names, and with those bits zero that was
;   palette 0 = PLAYPAL slot 10, the pickup GOLD tint, whose entry 0 is (53,46,17):
;   the whole ring sat in it permanently. It arrived with this flash -- before the
;   four slots went resident, palette 0 was still VBXE's stock Atari palette.
;   PF_PAL1 is slot 0, entry 0 = real black, and must NOT follow the flash: the
;   tint belongs on the picture, not on the dead area around it.
XDL_ATT_BASE    equ OV_NORMAL | PF_PAL1
FL_REDSPLIT     equ 3                ; DOOM red level >= this takes FL_PAL_REDHI
BONUSADD        equ 6                ; p_inter.c: bonuscount per pickup
DMG_MAX         equ 100              ; p_inter.c: damagecount cap
fl_dmg      = $0FA4                  ; player->damagecount
fl_bonus    = $0FA5                  ; player->bonuscount
fl_shown    = $0FA6                  ; the XDL byte committed now (st_palette)
; ---- monster ROTATIONS (2026-08-03; widened to 4 stored views 2026-08-07) ---
;   8-way mirrored walk views: pack_things stores 4 images per walk frame
;   (DOOM lump digits 1/2/3/5 = front, 3/4 front, profile, back; rows
;   img-major), spr_wrot picks the slot from the thing->viewer octant minus
;   TH_DIR, and rots 7 and 6 are the digit-2/digit-3 images drawn right-to-
;   left -- spr_one indexes the source column from the other end when the
;   vissprite's flip bit is set, exactly as the WAD's A2A8/A3A7 pairs mean it.
;   Only DOOM rots 3 and 5 (the 3/4 BACK views) are approximated, by the back.
vs_flip     = $0FA7                  ; [VIS_MAX] bit7 = draw this vissprite
                                     ;   mirrored (spr_proj stores row byte 7's
                                     ;   bit7; a STATIC sprtab row keeps its
                                     ;   radius there, <= 127, so bit7 is free)
wrot_nst    = $0FCF                  ; per level: stored views per walk image
                                     ;   (WTAB_N[0] = pack_things wn[0]: 4, or
                                     ;   1 for a front-only build, and nothing
                                     ;   else -- spr_wrot's table and
                                     ;   ai_setrow's img*4 both assume it;
                                     ;   en_init caches it out of bank $01)
sp_dflip    = $0FD0                  ; spr_wrot's chosen rot4 byte (slot bits
                                     ;   0-1, bit7 = mirrored); spr_dyn clears
                                     ;   it, spr_proj copies it to vs_flip
sp_dfix     = $0FD1                  ; spr_wrot mode: $FF = compute from
                                     ;   zp_rx/ry (projection), else = the
                                     ;   vs_flip byte to REPLAY (spr_one --
                                     ;   the vectors are stale at draw time)
                                     ;   ($0FD2-$0FDF still free)
