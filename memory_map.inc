                                     ;   home was the 64 B hole above use_ray
                                     ;   ($E3C0), which 20 slots outgrew; this is
                                     ;   the run the seg table vacated, and it is
                                     ;   in ram_map.py RESERVED (runtime data, no
                                     ;   XEX segment behind it)
MV_STATE    = MV_TAB                 ; [N] 0 idle, 1 lowering, 2 dwell, 3 raising
MV_TIMER    = MV_STATE+MV_NMAX       ; [N] dwell countdown, in VBLANKs
MV_FRAC     = MV_TIMER+MV_NMAX       ; [N] Q8 remainder of the VBLANK-scaled move
MV_STAY     = MV_FRAC+MV_NMAX        ; [N] high bit: the floor does not come back
MV_DSTL     = MV_STAY+MV_NMAX        ; [N] target floor, lo
MV_DSTH     = MV_DSTL+MV_NMAX        ; [N]               hi
MV_SRCL     = MV_DSTH+MV_NMAX        ; [N] height it started from, lo
MV_SRCH     = MV_SRCL+MV_NMAX        ; [N]                          hi
MV_SECL     = MV_SRCH+MV_NMAX        ; [N] &MAP_SECTORS[sector], lo
MV_SECH     = MV_SECL+MV_NMAX        ; [N]                       hi
MV_TABEND   = MV_SECH+MV_NMAX
MV_SPD      = $E6C3                  ; [N] how many times to HALVE this mover's
                                     ;   Q8 step -- the per-record floor speed
                                     ;   (tools/pack_things.py SPEED). The port
                                     ;   has one base per direction: mv_step
                                     ;   slides down at PLATSPEED*4 and mv_raise
                                     ;   climbs at FLOORSPEED, which are DOOM's
                                     ;   numbers for the FAST movers and 4x too
                                     ;   quick for the rest -- E1M8's 666 wall
                                     ;   fell in 2.5 s where DOOM takes 9.8, and
                                     ;   its staircase built in 3.2 s against
                                     ;   12.8. That slowness is the EFFECT.
                                     ;   NOT next to MV_TAB: mv_sndst starts at
                                     ;   $72C8, so the 200 B block cannot grow.
                                     ;   Under the ROM is fine -- every reader
                                     ;   (update_movers, mv_start) runs in the
                                     ;   frame loop with the ROM banked out.
mv_i        = $0FEA
mv_s1       = $0FEB                  ; the side the player came FROM, for the one
                                     ;   caller that needs it after the crossing
                                     ;   test is over: trig_walk's teleport gate
