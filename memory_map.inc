; ---- the MELT (f_wipe.c wipe_doMelt) ---------------------------------------
; Two whole 200-row screens. They have to be VRAM and not RAM for the obvious
; reason -- 32000 bytes each -- and for a second one that decides the design:
; WIPE_START survives a LEVEL LOAD, which is what lets the second melt
; (intermission -> the next level's first frame) exist at all.
;
; 2026-08-18: THEY MOVED. They used to sit at $059000/$061000, "in the VRAM
; above the intermission's own assets", which was true when WI_VRAM was $04A000
; and its stream was 15 chunks -- the run ended at $058FFF exactly. Both of
; those numbers are COMPUTED (pack_wi.py sizes the run; pack_menu.py puts it
; behind the HU strips, whose count is the level set's), and E2/E3 moved them:
; 27 level-name patches instead of 9 pushed WI_VRAM to $04F000 and the run to
; 24 chunks, so it now ends at $066FFF. The old melt buffers covered
; $059000-$068CFF -- i.e. the back half of the intermission's PIXELS, its two
; code overlay banks, and all five of the finale's. The first melt of a session
; ate the overlay it had just been copied out of, and the finale's font and
; texts never survived the first level exit.
;   WIPE_START goes to the 36 KB hole between the run and FRAME_C: nothing is
;   streamed there, so it survives a level load, which is the one thing it must
;   do.
;   WIPE_END goes to FRAME_B. It is only ever written at the START of a wipe and
;   read during it, and no frame is rendered while a wipe runs -- and FRAME_B is
;   the one buffer whose dead status-bar rows ($016900-$017FFF) make it a FULL
;   200-row screen: $010000 + $7D00 = $017D00, still clear of the pool.
WIPE_START  equ $067000              ; the picture being melted AWAY
WIPE_END    equ FRAME_B              ; ...and the one underneath it
WIPE_H      equ 200                  ; the melt covers the STATUS BAR rows too:
                                     ;   the intermission does, so the wipe into
                                     ;   and out of it has to
                                     ; (the 7-byte patch rows are NOT here: they
                                     ;  are ins-ed into stage 2 itself, so the
                                     ;  clip pool at $0700 stays free for the
                                     ;  melt's per-column y[] -- see wi.asm)
POOL_VRAM   equ $018000              ; the texture/sprite pool's base, named here
                                     ;   only so the two guards below can say so
    .if WIPE_START + SCREEN_WIDTH*WIPE_H > FRAME_C
        ert 'WIPE_START runs into FRAME_C -- see the VRAM map above'
    .endif
    .if WIPE_END + SCREEN_WIDTH*WIPE_H > POOL_VRAM
        ert 'WIPE_END runs into the texture/sprite pool -- see the VRAM map'
    .endif
; ...and the guard that was MISSING until 2026-08-26. The melt takes 200 rows of
; FRAME_B, i.e. exactly the status-bar rows the automap overlay was parked in,
; and nothing anywhere said the two could not both call them dead. They cannot.
    .if [AMOVL_BANK*$1000]+$1000 > WIPE_END && [AMOVL_BANK*$1000] < WIPE_END+SCREEN_WIDTH*WIPE_H
        ert 'AMOVL_BANK is inside the melt (WIPE_END..+200 rows) -- every level change destroys the automap overlay'
    .endif
    .if [AMOVL_BANK*$1000]+$1000 > WIPE_START && [AMOVL_BANK*$1000] < WIPE_START+SCREEN_WIDTH*WIPE_H
        ert 'AMOVL_BANK is inside WIPE_START (the melt source, 200 rows)'
    .endif
    .if [AMOVL_BANK*$1000]+$1000 > POOL_VRAM && [AMOVL_BANK*$1000] < ARENA_SPR_TOP
        ert 'AMOVL_BANK is inside the texture/sprite pool -- a level load eats the automap overlay'
    .endif
WI_E_INTER  equ 0                    ; mn_open's entry index: the intermission.
                                     ;   0 and 1 are NOT arbitrary -- wi_exit
                                     ;   derives the index as EXIT_REQ-1, so
                                     ;   these must stay in step with the two
                                     ;   EXIT_REQ values below.
WI_E_MELT   equ 1                    ;   ...and the SECOND melt, the one that
                                     ;   runs after the next level has loaded.
                                     ;   Stage 1 only -- stage 2's home is the
                                     ;   map slot and by then it holds a map.
WIPCT_BASE  equ $B9C8                ; wi_pctof: value*100/max, the shared half
WIPCT_END   equ $B9F1                ;   of all three percentages. Moved out with
                                     ;   wi_div16 on 2026-08-18 for the same
                                     ;   reason -- the per-episode lnodes and the
                                     ;   episode-relative wi_splats took the last
                                     ;   of the map slot's 11 pages, and stage 2
                                     ;   ended 14 bytes past $4C00.
WIDIV_BASE  equ $BC7F                ; wi_div16: the 16-bit restoring divide
WIDIV_END   equ $BCA0                ;   WI_drawStats' percentages need. Moved
                                     ;   out of stage 2 on 2026-08-18, when the
                                     ;   per-episode lnodes + wi_ebase and the
                                     ;   episode-relative wi_splats took the last
                                     ;   of the map slot's 11 pages. Pure
                                     ;   arithmetic on stage-2 VARIABLES, so
                                     ;   only the code moved; it is called with
                                     ;   the ROM banked out like the rest of it.
WI_XLOAD   equ MENU_RUN+$480        ; the across-the-load driver, in the 128 B
                                     ;   of the overlay window above $13FF that
                                     ;   TEX_STAGE does NOT eat. savegame.asm's
                                     ;   SG_RESUME is the same trick for the
                                     ;   same reason: it calls exit_level, and
                                     ;   the level stream destroys everything
                                     ;   below it, including the code that
                                     ;   called it.
EXIT_MELT   equ 2                    ; EXIT_REQ's second value: "the level is
                                     ;   loaded and drawn, now melt into it".
                                     ;   Riding EXIT_REQ costs no new byte and
                                     ;   main already tests it every frame.
; wi_exit does not compare these -- it derives the entry index as EXIT_REQ-1,
; which is two bytes instead of eight and there is no eight to spare. That
; makes the numbering load-bearing, so pin it here rather than in a comment
; somebody can renumber past.
    .if WI_E_INTER != 1-1 || WI_E_MELT != EXIT_MELT-1
