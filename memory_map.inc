                                     ;   the ROM, so $BC80-$BCA0 is slack now.
CLRBOTH_BASE equ $85E4               ; clear_both: ONE call, from main at boot, so
CLRBOTH_END  equ $85FF               ;   the slow window costs it ~30 cycles once
