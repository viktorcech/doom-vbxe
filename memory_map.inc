;   Rapidus' "Normal" window on this machine, so it must never be per-column
;   code); the fast low RAM it frees goes to the renderer. Entry is only ever
;   through the t_* trampolines, which bank the ROM out and back.
;   $D000-$D7FF stays hardware, so the usable RAM is $C000-$CFFF + $D800-$FFF9.
ROMBANK_BASE    equ $A1E6            ; rom_out/rom_in (2026-08-11 pm): the PORTB
ROMBANK_END     equ $A214            ;   banking pair, out of the cramped $05A8
                                     ;   stub and into ai_cand's vacated win2
                                     ;   hole. They run once per LEVEL (main's
                                     ;   entry, exit_level's SIO window, the
                                     ;   savegame path) -- never per frame -- so
                                     ;   the x11.2 fetch is invisible, and the
                                     ;   18 bytes are what let urom_init grow
                                     ;   the four 65816 NATIVE interrupt vectors
                                     ;   ($FFEA/$FFEE) the 16-bit blocks need.
UROM_STUB_BASE  equ $05A8            ; rom_nmi + urom_init, in the
                                     ; tail of the sound page (always visible)
UROM_TRAMP_BASE equ $1B00            ; trampolines, then colmerge behind them
UROM_TRAMP_END  equ $1B7F            ; 8 trampolines x 14 B            ; doors.asm vacated (the rest is free again)
; ---- column merging (colmerge.asm) ----------------------------------------
;   Draw one column, copy it over its identical neighbours. It runs per column,
;   so it HAS to be in the fast $0000-$3FFF window -- which is exactly what
;   moving doors.asm under the ROM bought.
BG_COLOUR       equ 247              ; palette index the view is cleared to. 247 AND
                                     ;   NOT 255 since 2026-08-26: PLAYPAL 0's entry
                                     ;   255 is rgb(167,107,107) -- a dull ROSE, not
                                     ;   black, and the comment that stood here said
                                     ;   black. So every clear_screen(BG_COLOUR)
                                     ;   painted the view PINK and you saw it for as
                                     ;   long as it took the BSP walk to cover it:
                                     ;   at boot, on NEW GAME, and on the way out of
                                     ;   every overlay. Measured on the hardware --
                                     ;   `db v:$000000` came back all $FF while the
                                     ;   screen was pink, and .vbxe_pal proved the
                                     ;   palette itself was right.
                                     ;   247 is rgb(0,0,0), i.e. what 255 was believed
                                     ;   to be. Index 0 is black too but the automap
                                     ;   uses it as a colour, which is why the border
                                     ;   (VIEW_BORDER) has it and the view does not.
