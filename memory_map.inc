;>>> RAM-BUDGET (generated by tools/ram_map.py -- do not edit by hand)
;
;   FREE RAM FOR NEW CODE:  NONE -- not one block of 32 B is left.
;   The next .proc has to EVICT something: move a cold one to bank $01
;   or under the ROM, or shrink a table. See the RESERVES below.
;
;   A procedure has to fit in ONE block, but it does not matter which: the
;   port already relocates code with `org` + absolute jsr (collision @ $0900,
;   check_bbox @ $1B00, tw_setup @ $8D00). When a segment outgrows its hole,
;   move a whole .proc out rather than letting the segment creep.
;
;
;   RESERVES -- real RAM, but it costs something to take:
;
;   THE TRAP: MADS does NOT check any of this. Code assembled into RAM that
;   is overwritten later (the $1000-$13FF SIO staging TEX_STAGE, the $4000
;   map slot, the streamed under-ROM blobs) assembles clean and then dies
;   at boot with no message -- a flat pink screen. Guards:
;     * tools/check_xex.py fails the build on any overlap (build*.ps1)
;     * the RESERVED list in tools/ram_map.py -- keep it in step with the
;       loaders (diskio.asm), it is what check_xex enforces
;     * this block is regenerated by tools/ram_map.py on every build
;<<< RAM-BUDGET

;==============================================================
; memory_map.inc -- DOOM BSP port: SINGLE SOURCE OF TRUTH for the memory layout.
;   Unlike wolf3d (where addresses grew scattered + pinned ad-hoc), ALL fixed
;   6502 RAM addresses and the VBXE 24-bit VRAM map live HERE, documented.
;   icl'd early by bsp_main.asm (after vbxe_regs.inc + map_syms.inc).
;
;   Advantage over wolf3d: the framebuffer is in VBXE (not main RAM) and DOOM is
;   flat-shaded (NO wall textures) -> both main RAM and VRAM are far roomier.
;==============================================================

; ---------------- screen geometry (160 LR wide) ------------------------------
SCREEN_WIDTH    equ 160              ; LR pixels (1 byte = 2 hw pixels, 256 colours)
SCREEN_HEIGHT   equ 200              ; 2026-06-03: 100 -> 200 (fill the screen like
                                     ; wolf3d). Cost: only the blitter FILL scales
                                     ; with height; the per-seg/per-column math is
                                     ; unchanged, so the FPS hit is small.
SCREEN_HALF     equ SCREEN_WIDTH/2   ; 80 = horizontal FOCAL (screen-X, 90 deg FOV)
VFOCAL          equ 160              ; VERTICAL focal (scale_z): decoupled from the
                                     ; horizontal 80 so wall heights fill the 200-tall
                                     ; LR view (2:1 pixels). Mirror of gui.py VFOCAL.
HHFP            equ (VIEW_HEIGHT/2)*256     ; horizon (view/2) in Q8 -> track_calc



;==============================================================
; 6502 RAM MAP (64 KB)
;--------------------------------------------------------------
;  $0080-$00FF  engine zero page          (.ds block in bsp_main.asm, grouped)
;  $0100-$01FF  CPU stack
;  $0340-$03E7  RECLAIMED FROM THE OS (OSFREE_BASE) -- see below
;  $0600-$06FF  early_init
;  $0700-$08FF  boot loader + sector buffer (boot.asm; dead once the engine runs)
;  $0900-$0FFF  tw_runs + collision tail   (TWRUNS_BASE/COLLFAST_BASE: the texture
;                                           run loop in Rapidus-fast RAM; door/mv
;                                           state from $0F00)
;  $1000-$13FF  per-frame render state     (THIS FILE)
;  $1400-$1FFF  spare
;  $2000-$3FFF  engine code                (bsp_main + math + renderer)
;  $4000-$4BFF  streamed map, LOW region    (header + sectors + textab + yoffs;
;                                           see map_syms.inc)
;  $4C00-$85FF  FREE -- the seg table's old home (2026-07-31: it went to Rapidus
;                                           bank $03). DISKIO2_BASE is the first
;                                           tenant. 2026-08-10: boot.asm now sets
;                                           MCR fast1+fast3 itself ($4000-7FFF +
;                                           RAM under the ROM are FAST windows;
;                                           $8000-BFFF stays chip -- MEMAC-A).
;                                           Verified in Altirra; hardware TBD
;  $8600-$8FFF  spare
;
; RECLAIMED OS RAM (2026-07-31). The OS source is the authority here:
; _pomocne/A800-OS-XL-Rev2-main/Atari_XL_OS_Rev.2.lab puts the eight 16-byte
; IOCBs at $0340-$03BF and PRNBUF at $03C0-$03E7 -- CIO and the printer. This
; port never calls CIOV; every load goes through SIOV, which uses the DCB at
; $0300-$030B and nothing above it. So those 168 bytes are ordinary free RAM and
; are now the biggest contiguous block the engine has.
; NOT taken, on purpose: $031A HATABS, and $03F8-$03FC BASICF/MINTLK/GINTLK/
; CHLINK -- the OS VBI (which this port keeps running for RTCLOK3) reads the
; cartridge interlock, and a wrong value there cold-starts the machine.
OSFREE_BASE     equ $0340
OSFREE_END      equ $03E7

; tw_texmask's parking slot (tw_setup.asm, 2026-08-10): the 22 B hole behind
; the $7898 segment was the largest truly free fast-window block left in the
; whole map (ram_map + RESERVED cross-check), and the proc is 21 B of pure
; win2 fetch cost (~7 ms/frame at x11.2). Nothing else fits anywhere: every
; further win2 evacuation has to EVICT cold data to a Rapidus bank first.
TWMASK_BASE     equ $78EA
TWMASK_END      equ $78FF

; ---- the RUN PAINTER's working set (paint.asm, TEX_RUNS) --------------------
; 20 bytes off the FRONT of the reclaimed OS block. They are per-column state
; in the hottest loop the engine has, so they want fast RAM ($0000-$3FFF is the
; Rapidus window; $1300, the other candidate, has 9 bytes left). NOT aliased
; onto the blit path's dead tw_* cells: tw_expand is shared with the SPRITE
; path (tw_expand_spr) and its cache keys live across passes, so overwriting
; them here would corrupt sprites, not walls.
PAINT_VARS  equ OSFREE_BASE
; The FOUR hottest cells -- pc_yacc (2 B), pc_y, pc_yn -- moved to ZERO PAGE
; 2026-08-10 (goal 2): touched ~15x per span, ~4000 spans a frame, and every
; abs->zp access saves a cycle and a byte. They are equated in paint.asm (the
; donors are declared after this file is included): pc_yacc = loc_floor,
; pc_y/pc_yn = zp_mvsec -- render-dead per-call scratch of movers/AI/player.
; PAINT_VARS+0..2 and +10..11 are their old cells, free again.
pc_dy       = PAINT_VARS+3            ; the current run's screen extent, Q8 rows
pc_cum      = PAINT_VARS+6            ; texel index just past the current run
pc_x        = PAINT_VARS+7            ; caller's X (draw_vspan owns zp_savex, and
                                      ;   that is what carries our run index)
pc_w        = PAINT_VARS+8            ; pt_dy input: whole texels
pc_f        = PAINT_VARS+9            ;   ... and the Q8 fraction
pc_sx       = PAINT_VARS+12           ; wall_src/low_src's saved X (the column
                                      ;   index array is read with absolute LONG,
                                      ;   which the 65816 only indexes by X)
pc_g        = PAINT_VARS+13           ; PT_MAXRUN budget left in this column
rs_rpt      = PAINT_VARS+14           ; SCREEN ROWS PER TEXEL, Q8 (the inverse of
                                      ;   rs_tpr -- the painter walks runs, not
                                      ;   rows). Exactly linear in the column.
rs_rptf     = PAINT_VARS+16           ;   ... its Q16 fraction
rs_drpt     = PAINT_VARS+17           ; per-column step, Q16 signed 24-bit
ptm_last    = PAINT_VARS+20           ; the rs_rpt pt_mul last BAKED into pt_dy's
                                      ;   operands (2 B): paint_col skips the
                                      ;   re-bake while it is unchanged -- flat
                                      ;   walls step rpt by <1 LSB per column.
                                      ;   Zeroed in setup_chains; pt_dy's operands
                                      ;   ASSEMBLE to the rpt=0 bake, so 0 is
                                      ;   consistent from the first frame on.
                                      ;   ($0356-$035F still free; ram_map.py
                                      ;   RESERVED covers to $0355)

;==============================================================
; PACKED MAP RECORD LAYOUT (tools/pack_map.py) -- ONE definition, used by every
; reader (renderer, seg_draw, collision, doors, use_ray, movers).
;--------------------------------------------------------------
;   Compacted 2026-07-25 so a second level fits in RAM at all. NOTHING is dropped
;   from the level -- the same vertices, segs, subsectors and BSP nodes are
;   there; only the wasted bytes per record are gone:
;     * seg 10 -> 8 B: front/back sector were u16 for a table that never exceeds
;       254 entries (E1M6, the biggest of episode 1, has 250). $FF = no sector.
;       Bonus: seg index * 8 is three shifts, where * 10 needed a shift-and-add.
;     * node 28 -> 12 B: the two child BBOXes (16 B) are read by R_CheckBBox
;       ALONE, and that cull is disabled (see checkbbox.asm / memory_map notes).
;       If the cull is ever re-enabled the bboxes come back as a SEPARATE array,
;       not by re-inflating the record the BSP walk reads every frame.
;   E1M2 went 34.3 KB -> 24.6 KB, which is what makes it loadable.
;==============================================================
SEG_V1      equ 0                    ; u16 vertex index
SEG_V2      equ 2                    ; u16 vertex index
SEG_FRONT   equ 4                    ; u8 sector id
SEG_BACK    equ 5                    ; u8 sector id ($FF = one-sided)
SEG_WALL    equ 6                    ; texid(0-5) + bit6 DONTPEGTOP + bit7 impassable
SEG_LOW     equ 7                    ; texid(0-5) + bit6 DONTPEGBOTTOM + bit7 EXIT
SEG_SIZE    equ 8
VSH_LIMIT   equ $27DA           ; ceiling of the vsh_mod/vsh_neg hole
NO_SECTOR   equ $FF                  ; seg back sector: none (one-sided wall)
NODE_X      equ 0                    ; i16 partition origin
NODE_Y      equ 2
NODE_DX     equ 4                    ; i16 partition direction
NODE_DY     equ 6
NODE_CH0    equ 8                    ; u16 right child (bit15 = subsector)
NODE_CH1    equ 10                   ; u16 left child
NODE_SIZE   equ 12
SSECT_FIRST equ 0                    ; u16 first seg index
SSECT_COUNT equ 2                    ; u16 seg count
SSECT_SIZE  equ 4

;==============================================================
; THE AUTOMAP (am_map.c) -- automap.asm. Costs ZERO permanent base RAM for its
; code and ZERO for its data; only the state block below is real RAM.
;   CODE     an overlay in MENU_RUN's window, exactly like menu.asm/savegame.asm
;            -- the bytes live in VBXE VRAM and are copied down when TAB is
;            pressed. It runs in $1000-$13FF and NOT the fifth page: the game
;            keeps running under the map (DOOM's automap does not pause), so
;            move_player's collision still owns bsp_stack at $1400.
;   DATA     AMSEG/AMSKIP/AMSEEN/AMFLG ride at the end of the streamed SEG
;            region in Rapidus bank $03 (pack_map._automap, map_syms.inc), so
;            they need no loader and reset themselves on a level load.
; The four are read with 65816 absolute-long addressing; these are their
; bank-qualified forms. The frame loop is already in native mode (underrom.asm),
; which is what lets am_mark index them with a 16-bit X.
;--------------------------------------------------------------
AM_BANK0    equ MAP_SEG_BANK*$10000  ; bank $03 base, for `sta.l AM_BANK0,x`
AMSEG_EXT   equ AM_BANK0 + MAP_AMSEG
AMSKIP_EXT  equ AM_BANK0 + MAP_AMSKIP
AMSEEN_EXT  equ AM_BANK0 + MAP_AMSEEN
AMFLG_EXT   equ AM_BANK0 + MAP_AMFLG
; am_mark -- r_segs.c:398. Parked in the 21-byte win1 hole behind load_sprcol,
; which is EXACTLY its size. win1 is Rapidus-FAST and this runs once per drawn
; seg (~250 a frame): in the $B377 win2 hole instead it would fetch at x11.2 and
; cost ~4 ms of a 180 ms frame. Nothing is evicted to make room -- the hole was
; already free (tools/tests/_ram_holes.py).
AMMARK_BASE equ $75AB
AMMARK_END  equ $75BF
; am_title -- hu_stuff.c's HU_Drawer half that the automap owns: the level name
; along the bottom of the map. It is RESIDENT and not overlay code for one
; reason -- it builds its own blitter control block instead of calling hud_blit,
; because hud_blit pins the destination to VRAM bank 0 (the status bar rows are
; SHARED between the buffers and painted once) and row TITLE_Y is inside the
; TRIPLE-BUFFERED view, so it has to go to zback_hi like everything else the
; frame draws. That is ~74 bytes and the overlay has 20; this block is free RAM
; the seg table left behind (tools/ram_map.py).
AMTITLE_BASE equ $7E3F
AMTITLE_END  equ $7E87             ; was $7E92: the eleven bytes of growth room
                                   ;   went to midtex.asm below, which needed
                                   ;   every one of them
; midtex.asm -- the two-sided MIDDLE texture (r_segs.c R_RenderMaskedSegRange):
; the see-through support struts and fences. mid_planes + mseg_snap + mseg_win
; are per-SEG / per-column code, so they take the biggest block the seg table
; left behind; mseg_prime and mseg_draw live in the two smaller ones below.
MSEG_BASE    equ $7E88             ; mid_planes, mtx_pegf, mtx_hook, mseg_snap
MSEG_END     equ $7FF1             ;   and mseg_win -- everything called per SEG
                                   ;   or per COLUMN, so it wants the fast half
MSEGPRE_BASE equ $756E             ; mseg_prime: 61 B, below AMMARK_BASE
MSEGPRE_END  equ $75AA
MSEGDRW_BASE equ $0DC3             ; mseg_draw: the cold driver, once a frame
MSEGDRW_END  equ $0E15
MTXBACK_BASE equ $AF0C             ; mtx_back + mtx_occ: with nowhere fast left
MTXBACK_END  equ $AF33             ;   (MUST stay below $B000 -- sprites.asm)
MTXPEG_BASE  equ $80F5             ; mtx_pegf, evicted from the fast block when
MTXPEG_END   equ $811F             ;   the snapshot learned to sample. Its hot
                                   ;   path is three instructions, so the slow
                                   ;   window costs it least of the three.
; paint_col's ?tail, evicted from the $0900 block (paint.asm): the flat fill
; that closes a column whose run budget ran out. It is the coldest thing in
; that block and the transparency test needed the bytes.
PTTAIL_BASE  equ $161D
PTTAIL_END   equ $1643
SEGS_EXT    equ AM_BANK0 + MAP_SEGS  ; the seg records, bank-qualified
SEGMID_EXT  equ AM_BANK0 + MAP_SEGMID
                                     ; [MAP_NSEGS] u8: which MIDTEX row this seg
                                     ; uses, $FF = it has no two-sided MIDDLE
                                     ; texture. Read with a 16-bit X exactly like
                                     ; AMSKIP above -- a side array and not a
                                     ; ninth byte of the seg record, because that
                                     ; record's address is three shifts and
                                     ; widening it would cost 15 KB of streaming
                                     ; per level for one byte (midtex.asm).
; The MIDTEX rows themselves. Everything about a strut except WHERE THE PLAYER
; IS standing is fixed at pack time -- the opening it hangs in is two sector
; heights, and pack_map.py asserts neither sector ever moves -- so the span the
; renderer would otherwise derive per frame (r_segs.c's texturemid arithmetic:
; two min/max pairs, an anchor and a clip) is precomputed here. mid_planes then
; costs two subtractions instead of ~180 bytes of 16-bit compares.
MTXTEX_EXT  equ AM_BANK0 + MAP_MTXTEX   ; u8 texid
MTXTLO_EXT  equ AM_BANK0 + MAP_MTXTLO   ; i16 world height of the span's TOP
MTXTHI_EXT  equ AM_BANK0 + MAP_MTXTHI
MTXBLO_EXT  equ AM_BANK0 + MAP_MTXBLO   ; i16 world height of its BOTTOM
MTXBHI_EXT  equ AM_BANK0 + MAP_MTXBHI
; (no peg column: process_seg's one-sided ML_DONTPEGBOTTOM rule already
;  computes exactly the shift a middle texture wants -- see mid_planes.)
AMFLG_EXT_D equ AM_BANK0 + MAP_AMFDELTA
                                     ; AMFLG read with the AMSEEN slot's own X:
                                     ; AMSEEN+line*2 + (AMFLG-AMSEEN) = AMFLG+line*2
KEY_TAB     equ $2C                  ; TAB = AM_STARTKEY/AM_ENDKEY (am_map.c:96).
                                     ;   The Atari scancode, same as wolf3d's.

; ---- the overlay, and where its bytes live -----------------------------------
; VRAM bank $17 is FRAME_B's STATUS BAR ROWS ($016900-$017FFF) -- the XDL shows
; the bar out of bank 0 under both buffers, so FRAME_B's own copy of those rows
; is never read and never written (clear_screen clears VIEW_HEIGHT, not 200:
; see bcb_clear_tmpl). ALL OF THAT IS TRUE AND IT WAS STILL THE WRONG PLACE.
; The MELT borrows the very same rows for the very same reason: WIPE_END is
; FRAME_B and WIPE_H is 200, so wi_grab writes from wa_b+VIEW_HEIGHT*160 =
; $016900 for WIPE_H-VIEW_HEIGHT-1 = 31 rows, i.e. through $017C60 -- over the
; whole 1263-byte overlay. The map therefore worked on E1M1 and was melt pixels
; from the first intermission onwards; mn_open then copied 256 bytes of SCREEN
; down to $1000 and jumped into it. Verified on the hardware 2026-08-26:
;   db v:$017000 -> B8 B9 67 BA ...   (pixels, not the overlay's A0 00 B9 00)
; It lives above WIPE_START's 200 rows now ($067000+$7D00 = $06ED00) and below
; FRAME_C ($070000). Both neighbours are FIXED equs -- unlike the pool ceiling,
; which is a runtime bump allocator (ARENA_SPR_TOP) and is the reason the first
; attempt at $03D000 did not survive contact with the hardware.
AMOVL_BANK      equ $6F
AMOVL_STAGE     equ $D800            ; ...and where MADS parks it in the XEX.
                                     ;   Nothing loads there -- split_menu_ovl.py
                                     ;   lifts the block into menu.bin before
                                     ;   check_xex.py runs, and check_xex is the
                                     ;   guard that fires if it ever does not.
; ---- the state that must survive the overlay being re-copied every frame -----
; Three bytes in the $A1FC/$A2B2 win2 holes. WIN2 is the block that can never be
; Rapidus-fast (MEMAC-A), which is exactly right for these: every one of them is
; touched a handful of times a frame, and the fast holes are worth more to the
; render path (see am_mark above, and mn_pend for the same reasoning).
am_on           = $A2B2              ; 0 = the 3D view. Non-zero = the map is up,
                                     ;   AND the value IS mn_open's bank byte
                                     ;   (BANK_EN|AMOVL_BANK) -- so am_gate needs
                                     ;   no constant to open with.
am_sh           = $A2B3              ; zoom: world units per screen ROW = 1<<am_sh
am_karm         = $A2B4              ; the zoom keys' press edge (0/1/2)
; ---- the four gates. Each one RETARGETS a `jsr` that was already there, so the
;      blocks they hook into (main's $2000 segment, hud.asm) pay nothing ------
AMGATE_BASE     equ $A38C            ; am_gate:  main's `jsr render_world`
AMGATE_END      equ $A396
AMKEY_BASE      equ $845B            ; am_key:   mn_key's `jmp fps_key` tail.
AMKEY_END       equ $8482            ;   MOVED off $A1FC-$A214 (2026-08-19): it
                                     ;   had two bytes left and closing the map
                                     ;   has to arm the border repaint, which is
                                     ;   five. This run is ENBVAR's unused tail
                                     ;   (en_boom keeps eleven bytes of the
                                     ;   thirty-five it claimed) up to
                                     ;   PJHK_BASE; $A1FC-$A214 is free now.
AMKGATE_BASE    equ $B64C            ; am_kgate: main's `jsr read_keys`
AMKGATE_END     equ $B657
AMWGATE_BASE    equ $B776            ; am_wgate: draw_hud_gate's `jsr draw_weapon`
AMWGATE_END     equ $B77F
; mn_ld_tab's new home. The automap overlay needs a fourth row (its VRAM chunk
; is not consecutive with the other two -- see AMOVL_BANK), and those four bytes
; pushed the boot STAGING block in the map slot into setup_chains at $4B18. The
; table is 16 bytes of pure data read once by load_menu, so moving the whole
; thing to a win2 hole gives the staging block 12 bytes back instead of costing
; it four -- and a boot-only table could not care less that win2 is slow.
MNLDTAB_BASE    equ $B377
MNLDTAB_END     equ $B391

; ---- collision (M5): relocated routines + tunables -------------------------
CALCU_BASE      equ $0610            ; calc_u -- per-column perspective u. Lives in
                                     ; the $0000-$3FFF block on purpose: that is the
                                     ; one region a Rapidus runs at full speed, and
                                     ; this runs once per textured column.
GUNFIRE_BASE    equ $FEAC            ; gun_match: the fire half, in the hole above
GUNFIRE_END     equ $FEDC            ;   the doors block. Cold (one shot that
                                     ;   reaches a wall), and it runs ROM-out
                                     ;   like everything else in the frame loop.
GUNMATCH_BASE   equ $067C            ; gun_seg_p (doors.asm) -- the hole calc_u
GUNMATCH_END    equ $0698            ;   leaves before door_index_of ($06B7).
                                     ;   2026-08-08: the END came DOWN from $06B6
                                     ;   -- gun_seg_p ends at $0698 and the 30 B
                                     ;   of growth room behind it is mn_open's
                                     ;   now (MNOPEN_BASE). The guard stays
                                     ;   honest either way; what is gone is the
                                     ;   slack, and this proc has not moved in
                                     ;   months.
                                     ;   give_bonus used to sit at $0680 and moved
                                     ;   into the AI block, so this is free again.
                                     ;   Cold: once per shot that reaches a wall.
BNTAB_BASE      equ $4D8B            ; BN_STAT/AMT/MAX, one entry per bonus id.
BNTAB_END       equ $4DEA            ;   2026-08-11: -> the old diskio hole, so
                                     ;   the $5600 run could host the AI block
                                     ;   (win2 evacuation). 96 B exact, en_seen
                                     ;   is the wall behind it.
                                     ;   2026-08-01: the powers took the ids past
                                     ;   24, three tables of 32 B is 96, and the
                                     ;   old $A3B0 slot has EIGHTY -- QSqr owns
                                     ;   $A400 (bsp_main.asm). Parked next to
                                     ;   POWER_BASE instead; they are read once
                                     ;   per pickup, so the address is free choice
                                     ;   ($A3B0-$A3FF is a spare 80 B hole again)
CBCORN_BASE     equ $5C00            ; cb_corners: check_bbox's four view-space
CBCORN_END      equ $5D40            ;   corners in 8 frac-table multiplies
                                     ;   instead of four transforms' sixteen.
                                     ;   2026-08-11 win2 evacuation: -> the freed
                                     ;   infight run. It ran ~50x a frame from
                                     ;   win2 = 6.1% of the frame in x11.2
                                     ;   fetches. ZERO growth slack: give_bonus
                                     ;   sits at $5D41 (GB_BASE).
COLLBSP_BASE    equ $6500            ; collide_blocked: the BSP range query every
COLLBSP_END     equ $677F            ;   monster step (up to twelve per
                                     ;   P_NewChaseDir) and every player step
                                     ;   runs -- 21552 cycles a call before the
                                     ;   axis fast path (tools/_dbg_aicost.py).
                                     ;   Below $8000 on purpose: that is the
                                     ;   accelerator's fast window.
COLLISION_BASE  equ $AB00            ; cold once-per-frame code -- it SWAPPED
                                     ;   places with tw_runs (2026-07-28) so the
                                     ;   per-column run loop gets the Rapidus-
                                     ;   fast $0900 page and collision takes the
                                     ;   old TWRUNS slot in the slow block.
                                     ;   $AB00, not $AAF0: the TCOS_HI frac page
                                     ;   owns $AA00-$AAFF since the second swap.
COLLISION_END   equ $AF3F            ; HUDCODE_BASE ($AF40) is next; 11 B spare
COLLFAST_BASE   equ $BAC0            ; coll_seg + collide_leaf (the two procs
                                     ;   the $AB00 slot cannot hold). 2026-07-28
                                     ;   round 2: they vacated the fast $0D51
                                     ;   spot for the chain EMITTERS (TWEMIT) --
                                     ;   cold code lives fine in the old
                                     ;   vissprite-record area, which shrank to
                                     ;   $BF50+ when the records went per-field.
COLLFAST_END    equ $BF4F            ; the real vissprite arrays start at $BF50
TWEMIT_BASE     equ $0D51            ; tw_expand + tw_blit: per-column/per-run
TWEMIT_END      equ $0E9D            ;   emitters in the fast page, after tw_runs
                                     ;   (sprite scratch + door state from $0E9E)
CHECKBBOX_BASE  equ $EAD0            ; R_CheckBBox, re-enabled 2026-07-29. NOT the
CHECKBBOX_END   equ $EC2A            ;   old $1B00 slot -- spawn_player/init_level/
                                     ;   ($EC2B up is ai_door's now -- the tail of
                                     ;   this block was free and the END moved
                                     ;   with it, so the guard stays honest)
                                     ;   exit_level took that over. Runs once per
                                     ;   far child (~50x a frame), so the under-ROM
                                     ;   hole is fine; the whole point is that it
                                     ;   PREVENTS work, it is not in an inner loop.
OLD_CHECKBBOX   equ $1B00            ; the $1B00-$1FFF block (spare RAM after the frac
                                     ; tables; relocated off the full $2000 segment).
                                     ; Holds doors.asm -- R_CheckBBox itself is no
                                     ; longer assembled (dead: the cull A/B test in
                                     ; render_node is off), which freed 397 B here.
VSH_BASE        equ $2790            ; vsh_mod/vsh_neg (DOOM texture pegging) -- parked
                                     ; in the hole the $2000 segment leaves at
                                     ; $2690, because that segment is full to $3FFF
SEGYOFF_BASE    equ $E480            ; seg_yoff (sidedef->rowoffset -> rs_vshw/rs_vshl).
                                     ; Under the ROM (runs once per drawn seg, after
                                     ; rom_out). 2026-07-28: moved $CD80 -> $E480 with
                                     ; USERAY/MVUSED -- the THINGS blob grew to $CE00
                                     ; (E1M6) and ate the old $CC00-$CDFF homes.
DOORIDX_BASE    equ $06B7            ; door_index_of + door_toggle, moved out of the
                                     ; $1B00 block into the hole behind give_bonus
                                     ; (must stay below CLIP_BASE at $0700)
USESIDE_BASE    equ $5432            ; use_side: the USE ray's cross-product sign.
                                     ;   2026-08-11 T2: nudged out of $50A0 so the
                                     ;   sprite head could take the whole
                                     ;   $50A0-$5476 run; it sits in ai_atk's old
                                     ;   tail now (still fast, still keypress-only;
                                     ;   pj_go at $5480 caps it).
PLAYER_R2       equ 256              ; collision radius^2 (R=16, DOOM)
PLAYER_H        equ 56               ; min vertical opening to pass a 2-sided line
MAXSTEP         equ 24               ; max climbable step up (DOOM); higher ledge blocks

; ---- doors (M6): DR open/wait/close. Runtime state PERSISTS across frames, so
;      it lives in dedicated RAM (NOT the per-frame rs_* scratch). The engine
;      animates MAP_SECTORS[door_sec].ceil between closed (=floor) and open
;      (=MAP_DOORS open_ceil). Static config is in the .bin (MAP_DOORS).
; Runtime door arrays: in Rapidus SRAM bank $01 at DOOR_EXT since 2026-08-18.
; They sat at $F000 under the OS ROM from 2026-07-28, where the chain of TWELVE
; [N] arrays ended EXACTLY at READKEYS ($F180) -- a hard 32-door wall (a brief 48
; that day let level load overwrite read_keys: the "stripes" boot). Episode 1 fits
; (E1M6 has the most at 24), but episodes 2 and 3 do not -- E3M5 43, E2M5 37,
; E3M4 35, E2M6 33 -- so rather than weld the excess doors permanently open, the
; whole block moved to the bank, which is where the only free space in the
; machine is. Every access is a long one: lda.l DOOR_x,x, a byte and a cycle
; dearer, paid a few dozen times a frame at most (update_doors early-outs on
; DOOR_NACT). $F000-$F17F was declared FREE under-ROM RAM here -- 384 B -- and
; it has not been true for a while: update_door30 ($F000-$F07F, with
; at_tables.inc inside it at $F067), fps_win ($F080-$F099), bl_pick
; ($F09A-$F0BA) and plr_steps ($F0BB..) all moved in behind the doors. Believe
; tools/ram_map.py, which reads the orgs, and not a sentence (2026-08-28).
;   The bank has no spare page above TH_HPL either, so this comes out of the
;   map's own EXT growth headroom: pack_map.py EXT_LIMIT drops to $6000 in step
;   with DOOR_EXT and fails the pack if a level set ever grows into it.
DOOR_EXT        equ $6000            ; bank $01, the 1 KB under TH_HPL ($6400)
DOORS_NMAX      equ 48               ; array stride; MAP_NDOORS (cap) must fit.
                                     ;   12 x 48 = 576 B, $01:6000-$01:623F, so
                                     ;   DOOR_EXT's kilobyte has 448 B to spare.
                                     ;   E3M5 (43) is the fullest map in episodes
                                     ;   1-3; doors.asm asserts the cap fits.
                                     ;   64 is the next real ceiling: past it the
                                     ;   MAP_DOORS/MAP_DSND record index (idx*4
                                     ;   into Y) wraps.
DOOR_BASE       equ [MAP_EXT_BANK*$10000]+DOOR_EXT
DOOR_STATE      = DOOR_BASE          ; [N] 0=closed 1=opening 2=open(dwell) 3=closing
DOOR_CURLO      = DOOR_STATE+DOORS_NMAX   ; [N] current ceiling, lo
DOOR_CURHI      = DOOR_CURLO+DOORS_NMAX   ; [N] current ceiling, hi
DOOR_WAIT       = DOOR_CURHI+DOORS_NMAX   ; [N] open-dwell countdown
DOOR_TRIGPREV   = $0F40              ; previous SPACE sample (USE edge-detect)
PLR_STEP        = $0F41              ; player units THIS frame (= SPD, plr_steps)
TRN_STEP        = $0F42              ; turn BAM THIS frame (TURN + carry, plr_steps)
trn_acc         = $0F43              ; Q8 turn fraction carried between frames
trn_held        = $0F44              ; g_game.c turnheld: 0 = no turn key was down
                                     ;   last frame, so THIS frame is the slow one
SPD             equ 24               ; player units per FRAME. FIXED again: the
                                     ;   2026-07-28 PSPD_Q8*dt_vbl time scaling was
                                     ;   reverted the same day -- at the real frame
                                     ;   rates it walked/turned 3-4x faster than the
                                     ;   fixed step ever did (unplayable), and
                                     ;   move_player's halfway collision probe
                                     ;   assumes a step <= 24 (gap 12 < PLAYER_R).
                                     ;   THE MOVE STEP STAYS FIXED FOR THAT REASON.
; ---- TURN RATE ---------------------------------------------------------------
; TURN stays PER FRAME (so the turn rate still follows the frame rate) and is
; simply 10% faster than it was. That is a deliberate choice, NOT the faithful
; number -- the faithful number was tried on 2026-07-30 and felt like far too
; much in play, which is the same verdict the 2026-07-28 dt_vbl attempt got.
;
; For the record, since it is the obvious thing to reach for again: the original
; is g_game.c angleturn[] = {640,1280,320} applied per TIC in p_user.c
; (`angle += cmd->angleturn<<16`) at TICRATE 35, and angle_t is a full 32-bit
; circle -- so 640<<16 = 0.9766% of a circle = 3.516 deg/tic = 123 deg/s. In
; 8-bit BAM at 50 Hz PAL that is 1.75 BAM per VBLANK, i.e. TRN_STEP =
; (dt_vbl*7+2)>>2, which at 5 fps is SIX TIMES the step below. It is rate-correct
; and it is too fast to aim with here. Do not "fix" this back without asking.
;
; What is NOT the problem: per-frame cost. A rotation frame costs one extra
; build_frac_tables (~7.5K cyc) over a walking frame -- 0.1% of the frame
; (tools/_verify_interleave.py). There is no rotation-specific work to remove;
; the frame is 87% draw_twall_col.
;
; (Whatever the rate, only PLR_STEP may ever be left alone here: move_player's
;  halfway collision probe assumes a step <= 24. read_input just adds to zp_ang,
;  so the turn has no such constraint.)
TURN            equ 3                ; whole BAM per frame (the original value)
TURN_FADD       equ 192              ; Q8 fraction added per frame: 192/256 = 0.75
                                     ;   BAM, so the average step is 3.75 = TURN
                                     ;   +25.0%. trn_acc carries it between frames;
                                     ;   3 frames in 4 turn 4 BAM, the 4th turns 3.
                                     ;   THIS IS THE ONLY KNOB for the turn rate:
                                     ;   77 = +10%, 128 = +16.7%, 192 = +25%,
                                     ;   256 would be +33% (and needs TURN=4,
                                     ;   TURN_FADD=0 instead -- the byte wraps).
TURN_SLOW       equ 1                ; the SLOW turn: g_game.c angleturn[2] = 320,
                                     ;   half of the normal 640, used while
                                     ;   turnheld < SLOWTURNTICS (6 tics = 0.17 s,
                                     ;   about ONE frame at this port's rate --
                                     ;   so: the first frame of every turn press).
                                     ;   Half of 3.75 would be 1.875 BAM; ONE BAM
                                     ;   is used instead, because 1 BAM is the
                                     ;   finest angle an 8-bit BAM can express and
                                     ;   DOOM's slow turn is a fine nudge against a
                                     ;   32-bit angle_t. It is also what makes a
                                     ;   distant thing hittable at all: only ONE of
                                     ;   the 256 angles lines a barrel up at 2048
                                     ;   units (tools/_dbg_aimgrid.py), and a 3.75
                                     ;   BAM step reaches barely a quarter of them.
PSTEP_BASE      equ $F0BB            ; plr_steps: roomy enough for the turnheld
PSTEP_END       equ $F111            ;   logic. 2026-08-18: was $FBC0, the tail
                                     ;   of the doors.asm block -- and that block
                                     ;   is what the DOOR_EXT move made 36 B
                                     ;   bigger, so plr_steps followed bl_pick
                                     ;   into the 256 B the door arrays freed at
                                     ;   $F080. Under the ROM either way, and
                                     ;   frame_dt tail-calls it once a frame.
                                     ;   $F112-$F17F (110 B) is what is left.
USE_DOOR        = $0F46              ; try_use: found door index ($FF = none)
USE_N           = $0F47              ; try_use: distance of the current ray sample
                                     ;   (0, STEP, .. USERANGE)
DOOR_STEP       = $0F48              ; whole units every door moves THIS frame
DOOR_FADD       = $0F49              ; ... and the Q8 remainder to accumulate
DOOR_DELTA      = $0F4A              ; this door's move this frame (step + carry)
DOOR_PLR        = $0F4B              ; door sector the player stands in ($FF = none),
                                     ;   sampled once per frame for the crush test
DOOR_NACT       = $0F4C              ; doors currently animating; 0 = update_doors returns at once
USE_SS          = $0F4D              ; try_use: subsector tested last (consecutive dedupe)
USE_BLK         = $0F4F              ; use_leaf: 1 = a crossed seg blocks the USE ray
USE_K           = $0F50              ; use_side: point offset of the third argument
dt_vbl           = $0F51              ; VBLANKs the last frame took (frame_dt) --
                                     ;   scales doors/lifts/buttons/face timers
                                     ;   ($0F52-$0F56 free: the FPS readout and
                                     ;    its draw_digit scratch were removed)
arm_sav         = $0F57              ; pl_armsub scratch: the points the armour
                                     ;   just ate. One byte of the old FPS run.
; ---- items: 1 BIT per thing, 0 = already picked up (spr_pickup / spr_add) ----
THALIVE_BASE    equ $0E78            ; thing_alive_bit (17 B, sprites.asm) -- the
THALIVE_END     equ $0E9D            ;   $0E78-$0E9D hole; fast RAM, hot per frame
THKILL_BASE     equ $BC32            ; thing_kill (21 B, sprites.asm): per-death
THKILL_END      equ $BC47            ;   event -> win2 hole (2026-08-11 pm; its
                                     ;   old $0D30 fast slot is ai_cand's now)
THING_ALIVE     = $0F60              ; [32] bitmap, mv_bit[idx&7] in byte idx>>3.
                                     ;   Was [128] one-byte flags: E1M2/E1M3 carry
                                     ;   up to 255 things, so idx >= 128 aliased
                                     ;   PSTATE ($0FE0) and the $1000 render
                                     ;   scratch -- sprites vanished as the view
                                     ;   changed and pickups never stuck.
                                     ;   ($0F80-$0FDF freed by the bitmap; the view
                                     ;   window took $0F80-$0F8A, see vw_x0 below.)
PICKUP_R        = 36                 ; DOOM: item radius 20 + player radius 16
; Player inventory, the wolf3d GetBonus model: a pickup that cannot be used right
; now (full health, full ammo) is NOT taken and stays on the floor.
PSTATE          = $0FE0              ; 0 health, 1 armor, 2 bullets, 3 shells,
                                     ; 4 rockets, 5 cells, 6 weapon bits, 7 key bits
pl_armt         = $0FDF              ; player_t.armortype: 0 none, 1 green (eats
                                     ;   damage/3), 2 blue (damage/2). PSTATE-1
                                     ;   ON PURPOSE -- load_things' boot loop
                                     ;   clears it with the same five
                                     ;   instructions (ldx #8 / sta PSTATE-1,x)
                                     ;   and the $0F00 page save carries it, so
                                     ;   the type survives a SAVE/LOAD like the
                                     ;   points do. p_inter.c splits them:
                                     ;   points say how much is left, the TYPE
                                     ;   says what share it absorbs.
; try_use's four points, 4 B each (x lo/hi, y lo/hi), indexed by use_side:
;   0 = ray start (the saved player position), 4 = ray end (start + USERANGE),
;   8 = seg v1, 12 = seg v2.  DOOM tests the use ray against LINEDEFS; the port
;   tests it against the segs of the subsectors the ray walks through.
;   2026-07-29: MOVED OFF the R_CheckBBox scratch. It used to squat on
;   $137A-$1389 because the cull was disabled and those bytes were dead -- the
;   note here said "if the cull is ever re-enabled, move these 16 bytes, do not
;   share them", and that is exactly what happened. try_use is keypress-only,
;   so the hole under the ROM costs it nothing.
USE_PT          = $E740              ; [16]
USE_PT_A        = USE_PT             ; ray start   (also the player-position save)
USE_PT_B        = USE_PT+4           ; ray end
USE_PT_P        = USE_PT+8           ; seg v1
USE_PT_Q        = USE_PT+12          ; seg v2
PS_HEALTH       = 0
PS_ARMOR        = 1
PS_BULLETS      = 2
PS_SHELLS       = 3
PS_ROCKETS      = 4
PS_CELLS        = 5
PS_WEAPONS      = 6
PS_KEYS         = 7
; ---- render toggles (keyboard) ---------------------------------------------
; $0F58 and $0F5A are FREE (2026-07-31): they held tex_off and dbg_nospr, the 'T'
; flat-wall and 'S' no-sprite debug toggles. Both were profiling aids from before
; the renderer was finished and are gone -- with them went their two per-seg
; branches in seg_draw and the one in render_world.
key_prev        = $0F59              ; edge-detect for the toggle keys (1 = held)
; Door motion is tied to TIME, not to the frame rate: DOOM runs its thinkers at
; 35 Hz and moves a door VDOORSPEED = 2 units per tic (= 70 units/s), waiting
; VDOORWAIT = 150 tics (4.29 s) at the top (p_spec.h). The port counts PAL
; VBLANKs (RTCLOK3, 50 Hz), so 70/50 = 1.4 units per VBLANK -- Q8 358 -- and the
; dwell is 150*50/35 = 214 VBLANKs. The old per-FRAME constants (4 units, 64
; frames) made a door 3.5x too slow and a dwell 3x too long at 5 fps, and both
; changed again with the frame rate (Rapidus!).
DOOR_SPEED_Q8   equ 358              ; units per VBLANK, Q8 (1.4 = VDOORSPEED @ 50 Hz)
DOOR_DWELL_VB   equ 214              ; VBLANKs open before auto-close (VDOORWAIT)
DOOR_DTMAX      equ 64               ; frame delta clamp: a 1.3 s hitch (level load)
                                     ; must not teleport a door across the room
; USE ray: DOOM P_UseLines traces USERANGE = 64 units and acts on the LINEDEFS it
; crosses. The port has no linedef table, so try_use walks the ray in USE_STEP
; samples to enumerate the SUBSECTORS it passes through and tests the ray against
; each one's segs (use_leaf): the first door line wins, the first wall stops it.
; STEP therefore only has to be fine enough not to skip a subsector.
USE_STEP        equ 4                ; USE ray sample spacing (units)
USE_NSTEPS      equ 16               ; samples -> reach = STEP*NSTEPS = 64
SKSTAT          equ $D20F            ; POKEY: bit2 (KEY) = 0 while a key is held
SK_SHIFT        equ $08              ; ...and bit3 = 0 while SHIFT is held. That is
                                     ;   the RUN key (plr_steps): DOOM doubles
                                     ;   forwardmove, the port takes a second step.
KBCODE          equ $D209            ; POKEY: hardware code of the last key
KEY_SPACE       equ $21              ; spacebar keycode = USE (DOOM convention)
KEY_MINUS       equ $0E              ; '-' = smaller 3D view (DOOM's own keys), the
KEY_EQUALS      equ $0F              ; '=' = bigger 3D view -- Atari '-'/'=' sit
                                     ;   right of P, so Altirra's default (POSITIONAL)
                                     ;   PC map reaches them with '[' and ']'.
KEY_LT          equ $36              ; ... which is why '<' and '>' (right of '0' on
KEY_GT          equ $37              ;   the Atari) do the same job: THOSE are what
                                     ;   Altirra sends for the PC '-' and '=' keys.
                                     ;   Both pairs bound -> the obvious key works on
                                     ;   real hardware AND in the emulator.
KEY_T           equ $2D              ; 'T' = textures on/off at RUNTIME (tex_flat):
                                     ;   the flat-colour walls are the fast frame
                                     ;   (hardware 2026-07-25: flat 6-7 VBLANKs vs
                                     ;   textured 14-16), so the player picks
KEY_1           equ $1F              ; '1'..'4' = select weapon (DOOM's own keys):
KEY_2           equ $1E              ;   1 fist, 2 pistol, 3 shotgun, 4 chaingun.
KEY_3           equ $1A              ;   read_keys turns them into wp_pending, which
KEY_4           equ $18              ;   A_WeaponReady acts on (weapon.asm)
KEY_6           equ $1B              ;   6 = the plasma rifle
KEY_5           equ $1D              ;   5 = the rocket launcher. '1' hands over
                                     ;   the CHAINSAW when it is owned, exactly
                                     ;   like G_BuildTiccmd (wp_select).
KEY_7           equ $33              ;   7 = the BFG9000 (2026-08-28). The scan
                                     ;   stopped at '6' for as long as WP_BFG had
                                     ;   no psprite; pack_weap.py gave it one, so
                                     ;   wk_tab grew a byte and 'T' moved up a
                                     ;   slot. $33 is the same OS key table the
                                     ;   IDKFA codes below come from -- the eight
                                     ;   values already in this file (a $3F, d
                                     ;   $3A, f $38, i $0D, k $05, l $00, t $2D,
                                     ;   TAB $2C) all agree with it, which is what
                                     ;   makes it safe to add a ninth without a
                                     ;   machine to try it on.
; ---- IDKFA (st_stuff.c cheat_ammo_seq -- the name in id's source is swapped
;   with cheat_ammonokey's, the SEQUENCES are what say which is which). The five
;   KBCODE values are out of the OS source's own key table
;   (_pomocne/A800-OS-XL-Rev2-main, the entries commented "$0D - I key" etc), not
;   guessed: KEY_L equ $00 above comes from the same table.
KEY_I           equ $0D
KEY_D           equ $3A
KEY_K           equ $05
KEY_F           equ $38
KEY_A           equ $3F
cht_prev        = $0F58              ; the last keycode the sniffer ACCEPTED, so a
                                     ;   held key is not read as a new press. $0F58
                                     ;   and $0F5A are the two bytes tex_off and
                                     ;   dbg_nospr left free in 2026-07-31.
cht_n           = $0F5A              ; how much of "idkfa" has been typed (0..4).
                                     ;   NOT initialised anywhere: cht_key range-
                                     ;   checks it instead, which costs the same 4
                                     ;   bytes and spends them in a block that HAS
                                     ;   them. Without one of the two, boot RAM
                                     ;   could index cht_tab out of bounds and hand
                                     ;   the player the cheat on his first keypress.
; ---- 3D view window size (DOOM's screenblocks: a smaller view = a faster frame)
;   DOOM's R_ExecuteSetViewSize scales the WHOLE projection with the window
;   (projection = centerx<<FRACBITS), so the 90-degree FOV never changes -- you
;   see exactly the same world, just drawn smaller. The port does the same, and
;   almost for free: both focal lengths live in the reciprocal tables, so scaling
;   the projection by k is ONE extra right shift folded into the reciprocal's
;   shift count (vw_sh) plus an optional *3/4 (vw_q34x) for the in-between sizes.
;   Everything else falls out of the occlusion arrays: render_world opens only
;   columns [vw_x0..vw_x1] with the row window [vw_y0..vw_y1], and every consumer
;   -- wall spans (draw_clip), bg_fill, the sprite clip snapshots -- already
;   clips to those, so a border column is simply "already solid" and costs the
;   BSP walk, the column loops and the blitter nothing.
;   The picture never moves: DOOM centres the window too, so the horizon stays at
;   row 84 (HHFP) and the projection centre at column 80 (SCREEN_HALF) -- which
;   is why track_calc and screenx_signed's centre need no change at all.
;   Speed: per-column CPU work scales with the width, the blitter with the AREA
;   (half size = 1/2 the columns, 1/4 the pixels).
VW_NSIZE        equ 5                ; 160x168, 120x126, 80x84, 60x63, 40x42
vw_x0           = $0F80              ; window, first column     ] these 8 are ONE
vw_x1           = $0F81              ; ... last column          ] record and MUST
vw_xend         = $0F82              ; ... x1+1 (loop bound)    ] stay in vw_tab's
vw_y0           = $0F83              ; ... first row            ] order: vw_apply
vw_y1           = $0F84              ; ... last row             ] copies them with
vw_ncol         = $0F85              ; ... x1-x0+1 (cols_open)  ] one 8-byte loop
vw_sh           = $0F86              ; ... extra reciprocal shift (0/1/2 = /1,/2,/4)
vw_q34          = $0F87              ; ... 1 = also *3/4 (vw_q34x)
vw_dirty        = $0F88              ; border repaints left (2 = into BOTH buffers)
vw_t            = $0F89              ; [2] vw_q34x scratch ($0F89-$0F8A)
VIEW_BORDER     equ 0                ; palette index the border is painted with
                                     ;   (PLAYPAL 0 = pure black). BG_COLOUR is the
                                     ;   view's own background and was 255 -- which
                                     ;   this comment called black and is not: see
                                     ;   BG_COLOUR, it is 247 now and both are black,
                                     ;   so the window edge no longer stands out.
VIEWSZ_BASE     equ $A000            ; vw_apply/vw_frame/vw_tab/vw_size -- cold code
VIEWSZ_END      equ $A076            ;   (once per keypress, one test per frame)
TRIGTAB_BASE    equ $2800            ; trig.inc's four 256-byte sin/cos tables.
                                     ;   PINNED, not left to its own `.align
                                     ;   $100`: the relocated procs below live in
                                     ;   the hole the alignment leaves, so the
                                     ;   moment the code before it shrank by 33 B
                                     ;   (load_palette moving out) the tables
                                     ;   aligned to $2700 instead and landed ON
                                     ;   vw_q34x. An org keeps the hole a hole.
VWQ34_BASE      equ $2705            ; vw_q34x: scale_z/screenx_signed call it ~400x
VWQ34_END       equ $272B            ;   a frame, so it must sit in FAST RAM (on a
                                     ;   Rapidus $8000-$BFFF is not) -- hence this
                                     ;   hole between row_lo and TWCHAIN, not $A000
DRAWSPAN_BASE   equ $272C            ; draw_span, moved out of the $2000 segment to
DRAWSPAN_END    equ $2746            ;   pay for the view-size code: that segment
                                     ;   ends at $3FFB, 4 B below the streamed map
; ---- HUD dirty repaint + the animated face (w3d hud_dirty model) ------------
;   The bar background and widgets are STATIC between events, and the 3D view
;   never touches rows 168+ -- so like w3d, the full bar+widget repaint runs
;   only while hud_dirty > 0 (set to 2 = once into EACH back buffer, by
;   init_doors, a taken pickup, or a face change). Every frame only hud_fps
;   runs: one strip COPY restoring the bar under the FPS digits + the digits.
hud_dirty       = $0F5C              ; full-repaint frames left (w3d hud_dirty)
face_cur        = $0F5D              ; HUD_TAB index of the face shown now
face_t          = $0F5E              ; VBLANKs until the face picks again
FACE_VB         equ 25               ; ST_FACECOUNT = TICRATE/2 = 0.5 s @ 50 Hz
GRIN_VB         equ 100              ; ST_EVILGRINCOUNT = 2*TICRATE = 2 s
TURN_VB         equ 50               ; ST_TURNCOUNT = 1*TICRATE = 1 s: how long the
                                     ;   OUCH face holds after a hit (hud_pain)
RANDOM          equ $D20A            ; POKEY LFSR: the look-around random pick
EXIT_REQ        = $0F5B              ; 1 = the USE ray crossed an EXIT line this
                                     ;     frame -> the main loop calls exit_level
                                     ;     after the flip (never mid-render: the
                                     ;     loaders overwrite the map under it)
KEY_L           equ $00              ; 'L' = force the first lift (diagnostic)
KEY_ESC         equ $1C              ; ESC = M_StartControlPanel / M_ClearMenu:
                                     ;   open the main menu in-game, and close it
                                     ;   again. DOOM's own key (m_menu.c:1699).
; ---- THE MENU OVERLAY (menu.asm) --------------------------------------------
; DOOM's menu is on ESC as well as at boot, and the boot menu's home -- the map
; slot -- holds the LEVEL once the game is running. So the menu proper is an
; OVERLAY that runs in the one block of RAM that is dead WHILE THE GAME IS
; PAUSED: $1000-$14FF, the per-frame render arrays + per-seg scratch + the BSP
; walk's stack (all rebuilt by the next render_world) and the 1 KB SIO staging
; buffer (nothing is loading while a menu is up). It lives in VBXE VRAM at
; $00E000 and is copied down on demand -- no drive, no permanent RAM.
;   It is assembled for MENU_RUN but LOADS at MNOVL_STAGE, the THINGS slot,
;   which is empty until the first load_things; tools/split_menu_ovl.py lifts
;   the block out of the XEX and into the menu asset blob before check_xex ever
;   sees it, so nothing is written to base RAM at boot at all.
MENU_RUN        equ $1000            ; where the overlay RUNS (5 pages)
MENU_RUN_END    equ $14FF
MNOVL_STAGE     equ $C000            ; ...and where MADS parks it in the XEX
MN_E_BOOT       equ 0                ; mn_open's entry index: the boot menu
MN_E_TITLE      equ 1                ;   ... TITLEPIC + display on
MN_E_INGAME     equ 2                ;   ... the ESC control panel
; ---- THE SAVE/LOAD OVERLAY (savegame.asm) -----------------------------------
; The SECOND overlay, in the same window and by the same mechanism: only one of
; the two is ever in RAM, and the menu tail-jumps into this one, so they never
; need each other's code. It carries its own SIO (read_sectors' SDRAM tee must
; NOT see save slots) and its own staging buffer.
SGOVL_STAGE     equ $C800            ; where MADS parks it in the XEX
SGOVL_BANK      equ MENU_OBANK+1     ; ... and the VRAM chunk behind the menu's
SG_E_SAVE       equ 0                ; sg_head's entry index
SG_E_LOAD       equ 1                ;   ... phase 1: header + reload the level
SG_E_REST       equ 2                ;   ... phase 2: the regions, after the load
SG_E_SCAN       equ 4                ;   ... read the six slot headers, then hand
                                     ;   the menu back for the picker
MN_E_PICK       equ 3                ; mn_open into the MENU overlay: run the
                                     ;   slot picker (the scan has just been done
                                     ;   by the other overlay, so this entry must
                                     ;   NOT re-freeze the frame)
sg_lvl          = $0FD5              ; [SAVE_SLOTS] the level each slot holds,
                                     ;   $FF = empty. Filled by SG_E_SCAN, read
                                     ;   by the picker -- which is in the OTHER
                                     ;   overlay, so it cannot live in either.
mn_ing_p        = $0FDB              ; mn_ing / mn_bgh / MainDef.lastOn had to
mn_bgh_p        = $0FDC              ;   come out of the menu overlay for the
mn_sysav_p      = $0FDD              ;   same reason: the picker ping-pongs
                                     ;   through the save overlay and back, and
                                     ;   an overlay variable is reset to its
                                     ;   assembled value every time mn_open
                                     ;   re-copies the page.
SG_E_QUIT       equ 3                ;   ... QUIT DOOM (M_QuitResponse). It lives
                                     ;   over here purely for ROOM: the menu
                                     ;   overlay is nine bytes from its ceiling
                                     ;   and QUIT never returns anyway.
SG_BUF          equ MENU_RUN+$400    ; 128 B: the one-sector staging buffer for
                                     ;   the regions SIO cannot address itself
SG_RESUME       equ MENU_RUN+$480    ; the phase-1 -> phase-2 driver. It has to
                                     ;   sit ABOVE $13FF: it is the one piece of
                                     ;   the overlay that runs ACROSS a level
                                     ;   load, and a load streams through
                                     ;   TEX_STAGE ($1000-$13FF).
sg_slot         = $0F54              ; the slot the menu picked (0..SAVE_SLOTS-1)
sg_mode         = $0F55              ; 1 = SAVE GAME, 2 = LOAD GAME (menu.asm)
sg_pend         = $0F56              ; 1 = a LOAD was picked at the TITLE and is
                                     ;   waiting for the first frame. The title
                                     ;   menu cannot do the load itself: main's
                                     ;   boot chain still has load_things and
                                     ;   load_palette to run, and load_things
                                     ;   would reset THING_ALIVE and re-stream
                                     ;   the things blob straight over it. So
                                     ;   the game starts normally and mn_pend
                                     ;   fires the load on the first frame,
                                     ;   which is one level load later but
                                     ;   exactly right. menu_boot clears it.
MNOPEN_BASE     equ $0699            ; mn_open: 19 permanent bytes -- select the
MNOPEN_END      equ $06B6            ;   overlay's VRAM bank, copy its first page
                                     ;   down and jump into it (the page then
                                     ;   copies the other four itself). In
                                     ;   gun_seg_p's old growth room; low RAM, so
                                     ;   it is reachable with the OS ROM banked
                                     ;   out, which is how the frame loop runs.
MNPEND_BASE     equ $BDF8            ; mn_pend: read_keys' real tail -- the
MNPEND_END      equ $BE0B            ;   deferred title LOAD, then vw_frame.
                                     ;   2026-08-11 pm: -> win2 hole (20 B exact;
                                     ;   10 cyc/frame, the x11.2 fetch is noise).
                                     ;   Its old $0D16 fast slot is cm_sscl's now
                                     ;   -- that one runs 5.1k cyc/f and must
                                     ;   stay fast.
MNKEY_BASE      equ $25A1            ; mn_key: read_keys' tail. THE 44-byte block
MNKEY_END       equ $25CC            ;   the RAM budget advertised as the last
                                     ;   free one -- an ESC reader is a fair
                                     ;   claim on it (34 B used).
mn_arm          = $0F52              ; ESC edge: 1 = a new press may open the
                                     ;   menu, 0 = wait for every key to come up.
                                     ;   One of the six bytes the FPS readout
                                     ;   freed at $0F52-$0F57.
mn_sy           = $0F53              ; itemOn, as the skull's screen ROW.
                                     ;   PERMANENT, and it has to be: mn_open
                                     ;   re-copies the overlay from VRAM on every
                                     ;   open, so a variable inside it is reset to
                                     ;   its assembled value each time -- which is
                                     ;   how the ESC menu first came up with the
                                     ;   skull on row 0. Out here it is
                                     ;   currentMenu->lastOn (m_menu.c:1546): the
                                     ;   cursor comes back where it was left.
                                     ;   mn_boot seeds it before the first menu,
                                     ;   so it is never random RAM.
;  $9000-$9FFF  MEMAC-A window (VBXE)       (RESERVED -- below sits the map)
;  $A000-$BFFF  spare / future
;  $C000-$FFFF  OS ROM (banked out during render -> RAM, like wolf3d)
;  (when ATR streaming lands: $5000-$5FFF becomes the SIO staging buffer; the map
;   no longer embeds at $4000 but streams per-level.)
;==============================================================

; ---- per-frame render arrays ($1000-$12FF; one byte per screen column) ------
solid_arr   equ $1000              ; [160] column fully closed (occlusion)
ytopc_arr   equ $1100              ; [160] open-window TOP row (portal occlusion)
ybotc_arr   equ $1200              ; [160] open-window BOT row
; The three arrays are SCREEN_WIDTH = 160 = $A0 bytes, so $10A0-$10FF is the
; tail of solid_arr's page and nothing else wanted it. The MASKED-SEG list
; (midtex.asm) lives there: it is per-FRAME state like the arrays around it,
; which is what makes the page safe -- $1000-$13FF doubles as TEX_STAGE, and
; nothing streams while a frame is being drawn.
MSEG_MAX    equ 16                 ; deferred two-sided-middle segs per frame.
                                   ;   E1M1 has 13 in the whole map and E1M6 34,
                                   ;   so this is a screenful, not a level -- and
                                   ;   16 is what fills the gap exactly, so the
                                   ;   margin over E1M3/E1M6's window runs (20
                                   ;   masked segs in one 640-unit cluster, about
                                   ;   half of them backfaced) is free.
ms_slo      equ $10A0              ; [MSEG_MAX] seg index, low byte
ms_shi      equ $10B0              ; [MSEG_MAX] seg index, high byte
ms_plo      equ $10C0              ; [MSEG_MAX] the seg RECORD's bank-$03 address
ms_phi      equ $10D0              ;   -- kept alongside the index so the replay
                                   ;   pays no shift chain for it
ms_ixa      equ $10E0              ; [MSEG_MAX] MIDTEX row (MAP_SEGMID)
ms_cpl      equ $10F0              ; [MSEG_MAX] clip block (bit0 = PER-COLUMN, so
                                   ;   mseg_prime's cursor step is one AND and a
                                   ;   shift; vs_cpl spells the same bit the
                                   ;   other way round)
bsp_stack   equ $1400              ; iterative BSP walk: far-child stack (128 entries x 2B)

; ---- frac-table transform multiply ($1500-$1AFF) ----------------------------
;   T[b] = |sin|*b and |cos|*b (3-byte entries, b=0..255), rebuilt each frame by
;   build_frac_tables; read by fmul_sin/fmul_cos so the view transform replaces
;   4 umul16/endpoint with table lookups. Frame-constant operand (sin/cos).
; 2026-07-28: the frac tables moved OUT of the Rapidus-fast window into the
; slow homes the per-column texture code vacated (see TWSETUP_BASE). They are
; runtime-built data (build_frac_tables, on rotation frames only), so the slow
; block costs them ~tens of us a frame -- nothing next to the per-column code
; fetches that now run from $1500. Page-aligned: FMUL indexes them with ,x/,y.
TSIN_LO     equ $8D00              ; |sin| * b, byte 0   (old tw_setup page)
TSIN_MI     equ $8E00              ; byte 1
TSIN_HI     equ $8F00              ; byte 2
TCOS_LO     equ $A800              ; |cos| * b, byte 0   (old blit-segment pages)
TCOS_MI     equ $A900              ; byte 1
TCOS_HI     equ $AA00              ; byte 2

; ---- per-seg render scratch ($1300-$13xx) -----------------------------------
;   Fixed-point: scales Q8(16b); tracks/accumulators Q8 24-bit signed; steps
;   Q8 16-bit signed. (Kept in RAM, not ZP -- ZP is for the hot pointers/math.)
rs_segi     = $1300                ; index of the seg being drawn (render_subsector
                                   ;   counts it up) -- the key into MAP_YBITS
rs_scL      = $1302                ; 1/Z scale, left endpoint   (Q8,16b)
rs_scR      = $1304                ; 1/Z scale, right endpoint
rs_sxL      = $1306                ; unclamped screen-X, left   (signed16)
rs_sxR      = $1308                ; unclamped screen-X, right
rs_span     = $130A                ; sxR - sxL (>=1)
rs_wtop     = $130C                ; worldtop = front ceil - pz (signed16)
rs_wbot     = $130E                ; worldbot = front floor - pz
rs_ycacc    = $1310                ; front-ceil track accumulator (24b)
rs_ycS      = $1313                ; front-ceil track step (16b)
rs_yfacc    = $1315                ; front-floor track accumulator
rs_yfS      = $1318                ; front-floor track step
; --- masked (two-sided MIDDLE) textures -- midtex.asm ------------------------
;   The 12 B here were rs_ycL/ycR/yfL/yfR, the front ceil+floor tracks at the
;   two endpoints: plane_setup went straight to acc+step and nothing had read
;   them since.
rs_mpass    = $131A                ; 1 = process_seg is running the MASKED pass
                                   ;   (the second visit a strut/fence seg gets,
                                   ;   after the walk has painted what is behind
                                   ;   it). Three tests in process_seg read it.
;           $131B                  ; FREE (1 B)
rs_midtex   = $131C                ; the walk: this seg's MAP_SEGMID row ($FF =
                                   ;   no middle texture). The masked pass: the
                                   ;   row's TEXID, which is what process_seg's
                                   ;   texture resolve wants.
;           $131D                  ; FREE (1 B)
ms_n        = $131E                ; masked segs collected this frame
ms_i        = $131F                ; mseg_draw's cursor (walks the list BACKWARDS
                                   ;   = far to near: the walk collected them
                                   ;   front to back)
ms_cur      = $1320                ; the clip block of the seg being drawn
ms_cstep    = $1321                ; 2 per column, or 0 for a uniform block
;           $1322-$1323          ; FREE (2 B)
ms_uni      = $1324                ; snapshot: 1 = one window over every column
ms_cbase    = $1325                ; snapshot: the block's base (low byte)
rs_ceilcol  = $1326                ; ceiling colour (palette idx)
rs_floorcol = $1327                ; floor colour
rs_wallcol  = $1328                ; wall / upper-step colour (col_a)
rs_yoffv    = $1329                ; seg_yoff: sidedef->rowoffset of this seg (u8)
rs_sc1      = $132B                ; endpoint-1 scale  (pre-order temp)
rs_sc2      = $132D                ; endpoint-2 scale
rs_sx1      = $132F                ; endpoint-1 unclamped sx (pre-order temp)
rs_sx2      = $1331
;           $1333-$1334          ; FREE (2 B): rs_pyc/rs_pyf, the per-column
                                   ;   front ceil+floor pixel rows. The column
                                   ;   loop keeps them in rs_pyc16/rs_pyf16 now.
; --- portals (two-sided segs): back tracks + per-column clip window ----------
rs_top      = $1335                ; current open-window top (ytopc[x])
rs_bot      = $1336                ; current open-window bot (ybotc[x])
rs_lowcol   = $1337                ; lower-step colour (col_b)
rs_isport   = $1338                ; 1 = two-sided (portal), 0 = solid wall
;           $1339-$133A          ; FREE (2 B): rs_pybc/rs_pybf, the per-column
                                   ;   back rows -- superseded by rs_pybc16/bf16.
rs_nt       = $133B                ; new window top after this seg
rs_nb       = $133C                ; new window bot
; --- mid_planes scratch (midtex.asm) -- the old rs_ybcL/ybcR/ybfL/ybfR, the
;     back ceil+floor tracks at the two endpoints, dead since plane_setup went
;     straight to acc+step.
ms_ot       = $133D                ; opening TOP  = min(front ceil, back ceil) - pz
ms_ob       = $133F                ; opening BOT  = max(front floor, back floor) - pz
ms_t        = $1341                ; snapshot: this column's window top
ms_b        = $1342                ;           ... and bottom (255/255 = closed)
ms_t0       = $1343                ; snapshot: the FIRST column's window, for the
ms_b0       = $1344                ;   uniform test
ms_off      = $1345                ; snapshot: bytes written into the block
;           $1346-$1348          ; FREE (3 B)
rs_ybcacc   = $1349                ; back-ceil accumulator (24b)
rs_ybcS     = $134C                ; back-ceil step (16b)
rs_ybfacc   = $134E                ; back-floor accumulator
rs_ybfS     = $1351                ; back-floor step
rs_spa      = $1353                ; draw_span start row
rs_spb      = $1354                ; draw_span end row
; --- plane_setup scratch (one height plane: world -> step + accumulator) ------
rs_wtmp     = $1355                ; world height in  (signed16)
rs_Ltmp     = $1357                ; track @ left (24b, transient)
rs_Stmp     = $135A                ; track step out (16b)
rs_acctmp   = $135C                ; accumulator-at-xa out (24b)
; --- faithful per-column clip (match render_view max/min; raw signed16 rows) --
rs_ra       = $135F                ; draw_clip: span start row (RAW signed16)
rs_rb       = $1361                ; draw_clip: span end row  (RAW signed16)
rs_pyc16    = $1363                ; front ceil row, raw signed16 (= ycacc>>8)
rs_pyf16    = $1365                ; front floor row
rs_pybc16   = $1367                ; back ceil row
rs_pybf16   = $1369                ; back floor row
rs_nt16     = $136B                ; new window top (raw signed16)
rs_nb16     = $136D                ; new window bot
; --- inv_span reciprocal track-step (replaces sdiv_prod) ----------------------
rs_invm     = $136F                ; 1/span reciprocal (INV_TAB[m]), 16-bit, once/seg
rs_invsh    = $1371                ; inv_span shift = RECIP_INV_K + e (byte)
rs_mag      = $1372                ; step_recip: |R-L| (signed24 magnitude, 3B)
rs_acc      = $1375                ; step_recip: 40-bit product accumulator (5B)
; --- R_CheckBBox scratch (BSP subtree cull; render-time, see check_bbox) -------
cb_top      = $137A                ; bbox corners read from the node (4x i16)
cb_bottom   = $137C
cb_left     = $137E
cb_right    = $1380
cb_X        = $1382                ; 4 transformed corners: view X (4x i16)
cb_Z        = $138A                ; 4 transformed corners: view Z (4x i16)
cb_lo       = $1392                ; min/max screen-X over the corners (signed16)
cb_hi       = $1394
cb_cnt      = $1396                ; count of corners behind the near plane
cb_xa       = $1397                ; clamped occlusion span [xa,xb]
cb_xb       = $1398
cb_off      = $1399                ; byte offset of this child's bbox in the node
;           $139A                  ; FREE (1 B): was cb_nbb, the near-child bbox
                                   ;   offset. render_node stored it on both sides
                                   ;   of the swap and nothing ever read it back --
                                   ;   check_bbox only ever culls the FAR child.
cb_fbb      = $139B                ; far-child bbox offset
; --- textured walls (B2, w3d-style per-column blit) --------------------------
;   Per seg: wall_tex (col_a) and low_tex (col_b) resolved to VRAM base + geom.
rs_wtexid   = $139C                ; wall texture id ($FF = none -> solid fallback)
rs_wtexad   = $139D                ; wall tex VRAM base addr (24-bit, col 0 @ row 0)
rs_wtexh    = $13A0                ; wall tex height (rows / column stride)
rs_wtexwm   = $13A1                ; wall tex width mask (w-1)
rs_ltexid   = $13A2                ; lower-step texture id ($FF = none)
rs_ltexad   = $13A3                ; lower-step tex VRAM base (24-bit)
rs_ltexh    = $13A6                ; lower-step tex height
rs_ltexwm   = $13A7                ; lower-step tex width mask
;   Per column (recomputed each column for the active texture):
rs_tsrc     = $13A8                ; column source VRAM addr = base + tex_x*texH (24b)
rs_texh_cur = $13AB                ; active texture height (column stride / tile size)
rs_txx      = $13AC                ; tex_x working (col - sxL, 16b)
; --- DOOM-correct vertical: 1 texel/world-unit, top-pegged, TILED (multi-blit) --
rs_worldh   = $13AE                ; wall world height f_ceil-f_floor (per seg)
rs_dscr     = $13B0                ; front wall screen height, Q4 (sixteenths of a row)
                                   ; from the Q8 plane accumulators -- tw_setup fills it
rs_tpr      = $13B2                ; texels per dest row, Q8 = worldH*256/dscr (per column)
rs_pegrow   = $13B4                ; texture top-peg screen row (per span, signed16)
tw_wt       = $13B6                ; wtexel accumulator, Q8 (world texel * 256), reduced
                                   ; mod texH*256 -> only 16 bits are live ($13B8-9 spare)
tw_row      = $13BA                ; current dest row in the tile loop
tw_b        = $13BB                ; span bottom row
tw_use8     = $13BC                ; 1 = sample the 8x-oversampled scratch column
tw_guard    = $13BD                ; runaway-loop guard (max runs per span)
tw_spy      = $13BE                ; SRC_STEPY: source samples per dest row (16b).
                                   ; = round(tpr*8) on the 8x scratch, round(tpr) raw
tw_dr       = $13C0                ; dest rows in the current run (16b)
tw_off      = $13C2                ; source offset inside the tile, in SAMPLES (16b)
tw_tile     = $13C4                ; tile length in samples (texH*8 or texH) (16b)
tw_base     = $13C6                ; source base VRAM address (24b)
tw_brow     = $13C9                ; tw_blit: destination top row
tw_bh       = $13CA                ; tw_blit: BCB HEIGHT field (SOURCE rows - 1)
tw_h        = $13CB                ; span height passed in by draw_twall_clip
tw_rem      = $13CC                ; dest rows still to draw in this span
tw_lim      = $13CD                ; 1 = run cut short (another run follows)
tw_lastsrc  = $13CE                ; DEAD in this build (3 B free, $13CE-$13D0):
                                   ; it keyed tw_expand's re-expand cache, which
                                   ; measured 0 hits in 913 calls and was deleted
                                   ; 2026-08-14 (textures.asm has the why). The
                                   ; equ stays only so the !TEX_RUNS wall path
                                   ; still parses -- that path is already dead
                                   ; anyway (its texture arena went too).
tw_boff     = $13D1                ; tw_blit: source offset for THIS blit (16b)
tw_rpt      = $13D3                ; ZOOMY: dest rows per source sample (1..8)
tw_n        = $13D4                ; source rows this run may use
tw_n1       = $13D5                ; whole source rows actually blitted
tw_r        = $13D6                ; leftover dest rows of the last zoom group
; --- speed: the per-column setup is the hot path, so it is memoised and the
;     divisions are avoided wherever the operands allow it -------------------
rs_texmask  = $13D7                ; texH*256-1 (valid only when rs_texpow2 = 0)
rs_texpow2  = $13D9                ; texH AND (texH-1): 0 => texH is a power of two
                                   ; => the "mod texH*256" is an AND, not a udiv24
rs_seglen   = $13E6                ; seg world length (approx) -- horizontal u scale
rs_segoff   = $13E8                ; MAP_SEGOFF[seg]: how far along the LINEDEF
                                   ;   this seg starts (DOOM's seg->offset).
                                   ;   calc_u adds it, so the texture carries on
                                   ;   across a BSP split instead of restarting.
                                   ;   Reuses the bytes of the old rs_ul, which
                                   ;   was written in two places and never read.
rs_uacc     = $13EA                ; world-u track along the seg (Q8, 24-bit)
;           $13ED-$13EE          ; FREE (2 B): rs_uS, the per-column u step. The
                                   ;   u track is interpolated from rs_t1/rs_t2
                                   ;   now, so no step is ever formed or stored.
rs_uflip    = $13EF                ; 1 = v2 projected left, so u runs L..0
tw_dsh      = $13E5                ; extra right-shifts applied to dscr so it fits
                                   ; 16 bits; taken off the dividend, not clamped
tw_s        = $13E2                ; oversampling factor S (1,2,4,8)
tw_ssh      = $13E3                ; log2(S)
tw_rsh      = $13E4                ; 8-log2(S): tw_wt >> rsh = sample index
tw_t0       = $13DC                ; first texel of the range put in the 8x scratch
tw_need     = $13DD                ; how many texels the span needs expanded
tw_ctmp     = $13B8                ; tw_expand: wanted end texel (cache containment
                                   ; test); the spare byte of the tw_wt accumulator
TW_PAD      equ 6                  ; texels expanded BEYOND the span's own range, so
                                   ; the next column's (slightly shifted) range still
                                   ; falls inside the scratch -> cache hit instead of
                                   ; the frame's most expensive blit. 0 disables it.
tw_soff     = $13DE                ; t0*8: sample index the scratch starts at (16b)
tw_lastt0   = $13E0                ; DEAD with tw_lastsrc above (2 B free): these
tw_lastneed = $13E1                ; were the expander cache's range, and nothing
                                   ; writes them any more.
; $13DA-$13DB FREE (2 B): the old tw_lastdscr, tw_setup's per-column dscr memo.
;   Deleted 2026-08-14 -- measured 0 hits in 3000 calls (_bench_cache.py): all
;   three tw_setup call sites zeroed it right before the jsr, so it could never
;   hit. See the note in tw_setup.asm where the compare chain used to be.
; --- perspective-correct horizontal texture coord ---------------------------
;   u is NOT linear in screen x. Interpolating it that way (what this renderer
;   did) smears one texel column across half a near wall -- the "walls go brown
;   up close" artefact. Instead track the two barycentric weights, which ARE
;   linear in x: t1 = scaleR*(x-sxL), t2 = scaleL*(sxR-x). Then
;       u = L * t1 / (t1+t2)
;   is exact perspective, and both tracks advance by a constant per column.
rs_t1       = $13F0                ; scaleR*(x - sxL) (24-bit, += rs_utR)
rs_t2       = $13F3                ; scaleL*(sxR - x) (24-bit, -= rs_utL)
; ---- the u-track's GUARDED endpoint scales (2026-07-31) ---------------------
;   rs_t1/rs_t2 are 24-bit cells and their init throws m_prod+3 away, so a
;   max(scale)*span product past 2^24 wraps and the texture u goes garbage --
;   the wall is painted with nonsense across its whole span. Reached whenever
;   the player stands IN a wall corner: Z collapses to ZNEAR, scale peaks and
;   the span saturates to the full screen. Measured at 312 % of 2^24 there
;   (tools/_verify_corner.py); every earlier sweep probed THING positions,
;   which never get closer than ~39 % -- which is exactly why this was left
;   in as "never measured".
;   u = t1/(t1+t2) is a RATIO, so halving BOTH endpoint scales is exact. Only
;   the u-track uses these copies; the y-tracks (wall heights, track_calc) keep
;   the full-precision rs_scL/rs_scR, so nothing else changes.
;   In the reclaimed OS block: the $1300 render page is full to the last byte.
rs_utL      = OSFREE_BASE+$81      ; rs_scL >> guard  (u-track step, left)
rs_utR      = OSFREE_BASE+$83      ; rs_scR >> guard  (u-track step, right)
UGUARD_BASE equ $2600              ; u_guard: once per SEG (not per column), but
UGUARD_END  equ $26E6              ;   still in the fast $0000-$3FFF window --
                                   ;   the $2000-tail hole, above $257E so the
                                   ;   engine segment keeps room to creep.
                                   ;   $26E7 is WPFEN_BASE: this is the ceiling.
cu_savex    = $13F6                ; calc_u preserves the column loop's X
;   ($13F7-$13FF free)
; TW_SAFE = 1 pins the wall texturing to the configuration that was known to
; render correctly: oversample 8x everywhere and always expand the whole texture
; column. It costs ~2x the blitter time (the expander is 2 VBXE cycles per sample
; it writes) but takes the sized-range and adaptive-S paths out of the picture.
; Flip to 0 to get the fast paths back.
TW_SAFE     equ 0
TW_RUNROWS  equ 32                 ; max SOURCE rows per run. Re-anchoring this
                                   ; often keeps the rounded rate from drifting
                                   ; more than ~1 texel from the exact one.
TW_MAXRUN   equ 32                 ; max runs per span (see draw_twall_col ?fill)
TWCLIP_BASE  equ $4C00             ; seg_len/wall_src/low_src/draw_twall_clip
TWCLIP_END   equ $4D8A             ;   (tw_texmask is parked at TWMASK_BASE).
                                   ;   2026-08-11 win2 evacuation: this was the
                                   ;   single hottest win2 block -- wall_src +
                                   ;   draw_twall_clip + low_src + seg_len =
                                   ;   ~21% of the frame in x11.2 fetches. Now
                                   ;   in the old diskio hole (diskio -> win2:
                                   ;   load-time code tolerates the chip bus).
                                   ;   ZERO slack: BNTAB sits at $4D8B.
;-- 2026-07-28: the per-COLUMN texture code swapped homes with the TSIN/TCOS
;   frac tables. tw_setup runs for every textured column (colmerge calls it up
;   to 3x per block) and the blit segment (tw_expand + draw_twall_col) runs per
;   column too -- 1.4 KB of instruction fetches at 1.79 MHz, ~2x the tw_runs
;   loop that already moved. The tables are the swap partner because they
;   TOLERATE the slow block: FMUL reads them ~6x per uncached vertex and
;   build_frac_tables rewrites them only on rotation frames -- data traffic in
;   the tens-of-us per frame, vs MILLISECONDS of per-column fetches.
PTSEG_BASE   equ $1500             ; pt_seg + pt_step (paint.asm): the painter's
