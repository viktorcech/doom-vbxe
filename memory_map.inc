; ---- DOOM texture pegging (r_segs.c R_StoreWallRange) -----------------------
;   DOOM anchors a wall texture either by its TOP or by its BOTTOM, chosen per
;   linedef (ML_DONTPEGTOP / ML_DONTPEGBOTTOM); this port only ever anchored by
;   the top, which is why a door face stood still instead of sliding up with the
;   door. The two anchorings differ by a CONSTANT number of texels, so rather
;   than a second peg row the blit just adds rs_vsh texels to the texel
;   coordinate -- the "mod texH" it already does folds the sum back in.
rs_pegf     = $13FA                  ; raw seg wall_tex byte: bit6 = ML_DONTPEGTOP
rs_pegl     = $13FB                  ; raw seg low_tex byte:  bit6 = ML_DONTPEGBOTTOM
rs_vshw     = $13FC                  ; per seg: texel shift for the wall / upper span
rs_vshl     = $13FD                  ; per seg: texel shift for the lower step
rs_vsh      = $13FE                  ; the shift the current draw_twall_col uses
rs_vsht     = $13FF                  ; vsh_neg scratch: the texture height
; (the HUD entry pointer borrows zp_ptr -- indirect indexing needs zero page)
; ---- vissprites: PARALLEL ARRAYS, one entry per sprite, indexed by X ---------
;   The old 16 B record forced VIS_MAX 11 (n*16 has to stay a byte AND the table
;   had to fit $BF50-$BFFF). Split per field instead: X is the sprite number, so
;   `sta vs_xb,x` needs no shift, and the 40-byte arrays can sit in whatever holes
;   exist -- which is what buys VIS_MAX 40 out of the SAME RAM the 11 records and
;   the (heavily over-provisioned, 512 B) clip pool already owned:
;   $0800-$08FF (the half of the pool the snapshots never needed) + $BF50-$BFFF
;   (the old record table). xa is NOT stored -- spr_one rebuilds it from x1,
;   which is exactly one array cheaper.
;                                     ; $0700-$07FF = clip pool (CLIP_BASE)
vs_xb       = $0800                  ; [40] last screen column
vs_x1l      = $0828                  ; [40] screen x of texture column 0 (signed 16)
vs_x1h      = $0850                  ; [40]
vs_ytl      = $0878                  ; [40] screen row of texture row 0 (signed 16)
vs_yth      = $08A0                  ; [40]
vs_ybt      = $3DB0                  ; [40] its LAST screen row, clamped to a byte
                                     ;   (255 = at or below the bottom of the view).
                                     ;   en_seen is the only reader: the hitscan has
                                     ;   to know the sprite's OWN vertical extent,
                                     ;   not just the window it was drawn in, and
                                     ;   re-deriving it there costs a sprtab walk
                                     ;   plus a multiply per candidate -- spr_add
                                     ;   already holds it in sp_ybot, so this is one
                                     ;   clamped store. It sits in the tail of the
                                     ;   $2000 engine segment and carries NO XEX
                                     ;   segment, so it is in tools/ram_map.py's
                                     ;   RESERVED list: without that, free_blocks()
                                     ;   re-advertises it as code space and the next
                                     ;   relocated proc lands on it.
vs_scl      = $08C8                  ; [40] Q8 vertical scale     ($08F0-$08FF spare)
vs_sch      = $BF50                  ; [40]   (= VFOCAL*256/Z; also the sort key)
vs_cpl      = $BF78                  ; [40] clip block, LOW byte (hi is always $07).
                                     ;      Blocks are 2 B aligned, so bit 0 is free:
                                     ;      1 = ONE window shared by every column
                                     ;      (uniform snapshot, see spr_proj).
vs_th       = $E6F8                  ; [40] THING index of this vissprite. The
                                     ;   record already carries vs_sid, but that is
                                     ;   the SPRITE (one per type+rotation) and the
                                     ;   shot needs the thing, to find its health.
                                     ;   Base RAM, not bank $01: spr_add writes it
                                     ;   in the render path and sp_ptr -- the only
                                     ;   free long pointer there -- is in use.
                                     ;   The $E6F8 hole is exactly VIS_MAX bytes.
                                     ;   IT IS NOT A CODE HOLE: spr_add rewrites
                                     ;   this array every frame. tools/ram_map.py
                                     ;   RESERVED carries it since 2026-08-02,
                                     ;   after a relocated proc parked here and
                                     ;   the game hung on the first lift.
; ---- enemy health: Rapidus SRAM bank $01, ABOVE the map ($01:0000-$01:63FF) ---
;   TH_HPL is the map's real ceiling in this bank -- tools/pack_map.py
;   EXT_LIMIT. It said LOS_EXT ($6A00) until 2026-08-15, which let the LIGHTS
;   section run into the health table on E1M2 and en_init wipe eight thinkers.
;   256 things x u16, split lo/hi into two pages so a thing index goes straight
;   into Y of an [zp],y -- an interleaved u16 array would need a shift per access.
;   Bank $01 because 512 B does not exist anywhere in base RAM, and because this
;   is cold: written at level init and on a hit, never in the frame path.
TH_HPL      equ $6400                ; bank $01: [256] health, low byte
TH_HPH      equ $6500                ; bank $01: [256] health, high byte
; ---- death animation (enemy.asm), all in bank $01 next to the health --------
;   DTAB is the per-level frame table pack_things.pack_death emits: a 16 B
;   header of "first row index" per monster KIND ($FF = not in this level), then
;   8 B rows of `vram addr(3), w, h, leftoff, topoff, TICS`.
;   The rows are SELF-DESCRIBING -- the tics byte ends the chain -- so the
;   engine needs no per-kind length table:
;       $FF     stay for good (DOOM tics -1): the corpse
;       $80|n   n tics, then the thing DISAPPEARS (chain hit S_NULL: the barrel)
;       n       n tics, then the next row
;   TH_STATE[i] is 0 for a live thing, else the absolute row index + 1, so
;   spr_proj resolves a dying thing with one test and one shift.
; MOVED to $01:8C00 (2026-08-03). The old $6600 home was a TRAP: DTAB_BYTES
; said $0400 but TH_STATE sits at $6800, so the REAL room was 512 B -- and the
; rotation rows (x3 views) made every .dtab 536-960 B: rows 54+ landed ON the
; TH_STATE/TH_TICS pages, en_init's clear then zeroed them back. The bank's
; $8C00-$FFFF run was free (the "does bank $01 have room" question), so the
; whole block lives there now with FOUR TIMES the row space.
; $01:6600-$01:67FF is a free 512 B hole again.
DTAB_EXT    equ $8C00                ; bank $01: the 16 B per-kind DEATH header
WTAB_EXT    equ $8C10                ; bank $01: 16 B per-kind WALK first row
WTAB_N      equ $8C20                ; bank $01: 16 B per-kind walk IMAGE count.
                                     ;   Per LEVEL, not per kind-in-general: how
                                     ;   many walk frames that level's sprite slot
                                     ;   could afford (tools/_walk_budget.py). The
                                     ;   RUN state machine does not care -- ai_setrow
                                     ;   masks the image index with it.
ATAB_EXT    equ $8C30                ; bank $01: 16 B per-kind ATTACK first row
PTAB_EXT    equ $8C40                ; bank $01: 16 B per-kind FLINCH row (info.c
                                     ;   painstate -- pack_things pack_pain,
                                     ;   $FF = the level could not afford one).
                                     ;   This slot was ATAB_N, the attack STATE
                                     ;   count: emitted since the attack chain
                                     ;   landed and never read by one line of
                                     ;   6502 -- ai_atk_next ends the chain off
                                     ;   the row's own AT_LAST bit instead
                                     ;   (2026-08-16)
ENGIB_BASE  equ $BA60                ; en_ovkill + en_gibq: the p_inter.c:719
OVKILL_BASE equ $B752                ; en_ovkill: P_DamageMobj's `health <= 0`
OVKILL_END  equ $B77F                ;   tail (overkill + clamp). Moved out of
                                     ;   ENGIB 2026-08-11 -- that block was full
                                     ;   to the byte and the test had to grow, so
                                     ;   it took the $B752 hole. It gives back the
                                     ;   26 B it used to hold down at $BA60.
PLARM_BASE  equ $BA95                ; pl_armset (P_GiveArmor's type half), moved
PLARM_END   equ $BAAE                ;   out of the give_bonus block 2026-08-11
                                     ;   into the tail en_ovkill's move freed:
                                     ;   folding all of P_GiveWeapon into
                                     ;   wp_give needed those bytes down there.
ENGIB_END   equ $BA94                ;   gib test. NOT $BABF: hud_ammo has owned
                                     ;   $BAAF-$BABF since 2026-08-10, so the old
                                     ;   figure let this block grow straight into
                                     ;   it and only check_xex's segment-overlap
                                     ;   test caught it (2026-08-11). Kill-time
                                     ;   only, so the slow
                                     ;   half of the map is fine.
ENGIB_VARS  equ $5BDB                ; en_ovk(2) + en_gib(1): the gib test's
                                     ;   scratch. The enemy block is full to the
                                     ;   byte, this hole is not.
XTAB_EXT    equ $8C50                ; bank $01: 16 B per-kind GIB first row
                                     ;   (p_inter.c:719 xdeathstate). $FF = this
                                     ;   kind has none in info.c -- the demon,
                                     ;   the lost soul, the caco, the baron and
                                     ;   the barrel all die the ordinary way.
ITAB_MAX    equ 16                   ; idle rings a level may carry (pack_things)
; 2026-08-07: the idle tables live INSIDE the existing 2 KB dtab slot. Moving
; the whole block down to $01:8000 to win 2 KB of coltab looked free -- nothing
; in this file claims $01:8000-$8BFF and the simulator booted it -- and it was
; a FLAT PINK SCREEN on the hardware, twice. Bisected: the rings never even
; started (an_init off) and it was still pink, so it is the DATA move, not the
; tick. Whatever really lives there is not written down; leave it alone.
ITAB_SID    equ $8C60                ; bank $01: 16 B, the SPRITE id of each idle
                                     ;   ring ($FF = slot unused). The barrel and
                                     ;   the pickups animate off info.c's own
                                     ;   spawnstate chain (pack_things.pack_idle)
ITAB_FIRST  equ $8C70                ; bank $01: 16 B, its first DTAB row
ITAB_N      equ $8C80                ; bank $01: 16 B, how many rows the ring has.
                                     ;   All three share page $80, so an_step
                                     ;   walks them with ONE pointer and Y +$10/$20
PTIC_EXT    equ $8C90                ; bank $01: 16 B per-kind FLINCH TICS -- how
                                     ;   long ai_pain2 holds the painstate frame,
                                     ;   info.c's own chain length (0 = the kind
                                     ;   has no painstate). This was PAIN_TICS,
                                     ;   ONE number for every kind, until
                                     ;   2026-08-26; it was 6 and info.c wants 4
                                     ;   (imp/demon/baron), 6 (both zombies, lost
                                     ;   soul, spider), 10 (CYBERDEMON) and 12
                                     ;   (cacodemon). It is a tenth DTAB header
                                     ;   and not an mk_* table because MKTAB is
                                     ;   full to the byte (en_bdist ends at $3DAF)
                                     ;   while the row array had the room: E1M6,
                                     ;   the busiest level, packs 222 of 236.
                                     ;   MUST stay on page $8C with PTAB_EXT --
                                     ;   ai_pain2 reaches it by rewriting the LOW
                                     ;   byte of the pointer it already has.
DTAB_ROWS   equ $8CA0                ; bank $01: the 8 B frame rows. Death, walk
                                     ;   and attack rows all share this array and
                                     ;   the format, which is why spr_dyn needs no
                                     ;   second reader. $8C90 until PTIC_EXT took
                                     ;   that page (2026-08-26) -- pack_things
                                     ;   DTAB_NHDR is the other half of this
                                     ;   number and nothing derives one from the
                                     ;   other, so they move together or every
                                     ;   row index in the game is 16 B off.
DTAB_BYTES  equ $0800                ; the whole slot (pack_things DTAB_MAX):
                                     ;   160 B of headers + up to 236 rows --
                                     ;   the row INDEX is a byte (row+1), so
                                     ;   254 is the hard ceiling anyway.
; ---- T4 column tables + B1 frame table (.sprcol v2), above the DTAB ---------
;   pack_things.emit_sprcol writes it as ONE stream, load_sprcol (diskio.asm)
;   lands it here in a single read_ext run, spr_fget/spr_ctcol read it.
;   Contracts: tools/_verify_sprcrop.py (columns) + tools/_verify_arena.py
;   (the arena). A sprtab/DTAB row's byte 0 is the FRAME ID; the FTAB knows
;   the frame's file offset, stored size and coltab; FARENA is the residency
;   table -- the frame's VRAM arena address, 0 = not fetched yet. FARENA is
;   NOT in the file: arena_init clears it at every level load.
SPRCOL_BANK equ $08                  ; 2026-08-21: the coltab run LEFT bank
                                     ;   $01. It was 24 KB there because bank
                                     ;   $01 is full (219 B), and 24 KB is what
                                     ;   made plan_views drop NSTOR to 1 -- no
                                     ;   side or back views for ANY monster on
                                     ;   7 of the 16 cacodemon levels, E3M8
                                     ;   among them on 30 things (the spider is
                                     ;   128 units wide and its frames alone
                                     ;   spend the run). The Rapidus has 14.5 MB
                                     ;   and this port uses $01-$06 with $07
                                     ;   parked for music, so $08 was free and
                                     ;   whole. spr_fget and spr_ctcol are the
                                     ;   only readers and both now say $08 in
                                     ;   their long pointer; FARENA stays here,
                                     ;   it is runtime-only and not streamed.
SPRCOL_EXT  equ $0000                ; bank $08: coltab blocks, packed
FTAB_EXT    equ $E000                ; bank $08: [255] 8 B {u24 file_off,
                                     ;   u16 size, u16 coltab, pad}
FARENA_EXT  equ $FC00                ; bank $01: [255] u24 arena addr (runtime;
                                     ;   765 B, $FEFC end)
; $01:FF00-$FFFF is FREE (256 B): it was TEXAR, the B2 texture-arena residency
; table, deleted with tex_fget on 2026-08-14 -- with TEX_RUNS=1 painted walls
; read their runs straight out of SDRAM, so no texture ever entered an arena.
; An ATTACK row's tics byte: bits 0-4 the tics, bit 5 = the chain LOOPS from here
; instead of ending, bit 6 = this state's action deals the damage (p_enemy.c
; A_PosAttack &c), bit 7 = last state, go back to RUN.
;   AT_REFIRE took bit 5 on 2026-08-20. p_enemy.c A_SpidRefire: S_SPID_ATK4's
;   nextstate is S_SPID_ATK2, NOT S_x_RUN1 like every other chain's last state --
;   the spider mastermind keeps firing until it loses sight of its target, which
;   is the whole difference between E3M8's boss and a shotgun guy with 3000 hit
;   points. Without it the port fired ONE six-pellet burst per pass and the
;   chaingun rattle was a single shotgun blast (the player heard it first).
;   The tics gave up a bit for it: the longest attack state in DOOM is
;   S_SPID_ATK1's 20 tics, and pack_atk asserts every one of them fits in five.
AT_FIRE     equ $40
AT_LAST     equ $80
AT_REFIRE   equ $20                  ; AT_LAST|AT_REFIRE -> ai_refire decides
AT_TICS     equ $1F                  ; the tics themselves, under those three flags
; ---- and two more per-thing AI pages for it
TH_MODE     equ $7D00                ; bank $01: [256] 0 = RUN chain, 1 = ATK chain
TH_SEEN     equ $7E00                ; bank $01: [256] 0/1 -- did the last sight
                                     ;   ray this thing was given reach ITS OWN
                                     ;   TARGET? Written by ai_look (one ray a
                                     ;   frame, round-robin), read by aif_pvis
                                     ;   for a player target and aif_mvis for a
                                     ;   monster one. Cleared per level by
                                     ;   sg_seen -- bank $01 is SRAM and this
                                     ;   page had NO initialiser until
                                     ;   2026-08-25, so every level after the
                                     ;   first opened on the previous one's
                                     ;   answers.
                                     ;   (This comment read "ai_tag when this
                                     ;   thing was last a vissprite" until then
                                     ;   -- it was never a tag and never the
                                     ;   vissprite list; that oracle is
                                     ;   ai_isvis, which reads vs_th directly.)
TH_STATE    equ $6800                ; bank $01: [256] 0 = alive, else row+1
TH_TICS     equ $6900                ; bank $01: [256] tics left in the row
; ---- barrel line of sight (enemy.asm en_lfind/en_los, tools/pack_los.py) -----
;   PIT_RadiusAttack calls P_CheckSight before it damages anything, so in DOOM a
;   blast stops at a wall; this port had no sight test at all and the explosion
;   went through. A real BSP sight trace is a lot of 6502 for something that
;   fires a handful of times per level -- and a barrel never moves, so the answer
;   is precomputed offline instead: PIT_RadiusAttack's reach is CHEBYSHEV
;   (dist = max|dx|,|dy|, minus BOOM_R, out of range at BOOM_DMG), so the damaged
;   area is exactly the square |dx|,|dy| <= 143, and one bit per 16x16 cell of it
;   is 19x19 bits per barrel. One record per barrel, one table per LEVEL, streamed
;   into the Rapidus bank by load_los (diskio.asm):
;       +0  u8 thing index ($FF = empty record)
;       +1  pad
;       +2  LOS_GRID rows of LOS_ROW bytes, MSB first: bit c of row r set = the
;           CENTRE of cell (c,r) -- world (bx+16*(c-9), by+16*(r-9)) -- is
;           visible from the barrel.
;   Two-sided lines never block: one of them may be a door that is shut when the
;   table is built and open when the barrel goes off, and the safe direction is
;   to let the blast through. So this is "the blast does not cross a WALL", not
;   full P_CheckSight. The cell centre decides the whole cell, so the sight edge
;   can be off by up to 8 units against a 143-unit blast.
LOS_EXT     equ $6A00                ; bank $01, right above TH_TICS
LOS_NMAX    equ 40                   ; records per level (E1M4 has the most: 32
                                     ;   barrels). Past that a barrel simply gets
                                     ;   no record -- and the old, wall-ignoring
                                     ;   blast, which is the safe way to degrade.
LOS_REC     equ 80                   ; record stride (2 + 19*4 = 78, rounded up)
LOS_GRID    equ 19                   ; cells per side
LOS_ROW     equ 4                    ; bytes per row: 4 and not 3, so en_los turns
                                     ;   a row into an offset with two ASLs
LOS_MID     equ 9                    ; the barrel's own cell
LOS_BIAS    equ 152                  ; = LOS_MID*16 + 8, so a cell index is
                                     ;   (LOS_BIAS - (blast - target)) >> 4
LOS_BYTES   equ LOS_NMAX*LOS_REC     ; 3200 B: $01:6A00-$01:767F
; ---- monster AI (enemy_ai.asm), one page per field in bank $01 --------------
;   Indexed by THING, the way TH_HP/TH_STATE are, so a thing index goes straight
;   into Y of an [zp_ptr],y with no shifting -- and every page is 256 B aligned,
;   so switching fields is one store to zp_ptr+1 (ai_bank/ai_get/ai_put).
;   TH_WROW doubles as the "is it chasing" flag: 0 means it is not, which is
;   also what spr_dyn reads to decide between the spawn frame and a walk frame.
TH_WROW     equ $7700                ; bank $01: [256] walk row+1 (0 = not chasing)
TH_WST      equ $7800                ; bank $01: [256] RUN state index (info.c)
TH_WTIC     equ $7900                ; bank $01: [256] tics left in that state
TH_DIR      equ $7A00                ; bank $01: [256] movedir 0..7, 8 = DI_NODIR
TH_MCNT     equ $7B00                ; bank $01: [256] movecount (P_TryWalk)
TH_KIND     equ $7C00                ; bank $01: [256] the kind byte, cached at
                                     ;   wake so the per-tic path never walks the
                                     ;   sprite table for it
; ---- thing-vs-thing collision (p_map.c PIT_CheckThing) ----------------------
;   info.c radius per THING, 0 = not MF_SOLID (a pickup, a player start, an
;   already-removed thing). en_init fills it from the per-SPRITE radius table in
;   the .things blob (pack_things p_rad) so the sweep costs one [zp],y and no
;   sprite-table walk. Monsters AND the obstacle decorations (barrel, pillar,
;   lamp) get one; DOOM blocks on both.
TH_CELL     equ $6600                ; bank $01: [256] the thing's blockmap cell,
                                     ;   ((y >> 9) & 7) << 3 | ((x >> 9) & 7) --
                                     ;   a 512-unit grid wrapped into 8x8.
TH_BNEXT    equ $6700                ; bank $01: [256] next thing in that cell,
                                     ;   $FF = end. With BLK_HEAD this is
                                     ;   p_maputl.c's blockmap: P_BlockThingsIterator
                                     ;   walks a cell's list instead of the whole
                                     ;   thing table, which is what en_solid used
                                     ;   to do -- 255 records per move test, paid
                                     ;   by every walking monster on every step.
                                     ;   blk_link keeps it (ai_track is the one
                                     ;   place a thing's x/y is committed), and a
                                     ;   wrapped cell only ever adds candidates
                                     ;   the exact test then rejects.
TH_RAD      equ $7F00                ; bank $01: [256] radius, units
; ---- INFIGHTING (infight.asm) -- mobj_t.target / mobj_t.threshold ------------
;   Everything the AI used to do was player-relative. p_enemy.c never mentions
;   the player: it reads actor->target, and p_inter.c P_DamageMobj is what points
;   that at whoever last hurt it -- source included when the source is another
;   monster. Two more per-thing pages give this port the same two fields.
;   They live at $01:8A00, right ABOVE the reciprocal/trig block ($01:8000-89FF)
;   -- the first pages in the bank that nothing else claims (the map itself ends
;   at $01:6394 and the seg records went to a bank of their own).
; 2026-08-20 -- THE COLLISION. These two pages were at $01:8A00/$01:8B00 and
; PJSLOT_EXT is at $01:8A00 too: eight 64-byte projectile contexts, $8A00-$8BFF,
; exactly on top of both. Each comment claimed "the first free page of the bank"
; and each was written months apart. Every plasma bolt or rocket in flight was
; scribbling over 64 things' target+threshold, and every retaliation was
; scribbling back over a live bolt. Proved by running pj_slot in sim6502, not by
; reading. TH_TARG moves down to $6300 -- the tail of DOOR_EXT's kilobyte, which
; the door arrays (13 x DOORS_NMAX = 624 B, $6000-$626F) do not reach -- so it
; is now contiguous with the thing-page run that used to start at TH_HPL, and
; the savegame saves $6300..$69FF as ONE seven-page region instead of six pages
; plus a separate two. TH_THRS takes $FF00, the 256 B TEXAR left when tex_fget
; died on 2026-08-14. tools/bank_map.py is the guard that stops this happening
; again -- bank $01 had no map before today, which is the whole reason it did.
TH_TARG     equ $6300                ; bank $01: [256] 0 = the PLAYER, else the
                                     ;   target thing index + 1
TH_THRS     equ $FF00                ; bank $01: [256] threshold. While it is
                                     ;   nonzero a new hit does NOT retarget the
                                     ;   monster, which is what stops it flipping
                                     ;   between two attackers every tic.
                                     ;   $8B00 -> $FF00 with TH_TARG, see there.
                                     ;   This is the LAST free page in the bank:
                                     ;   FARENA_EXT ends at $FEFC and $FF00 was
                                     ;   TEXAR's. Anything new needs a bank of
                                     ;   its own now -- tools/bank_map.py says
                                     ;   what is left, which is 400 B at $6270
                                     ;   and 64 B behind BLK_HEAD.
AI_THRESH   equ 100                  ; p_local.h BASETHRESHOLD
AI_EAST      equ 0                   ; p_enemy.c dirtype_t, in ITS order: the
AI_NORTHEAST equ 1                   ;   opposite of a direction is dir^4, which
AI_NORTH     equ 2                   ;   is the whole reason ai_newdir can test
AI_NORTHWEST equ 3                   ;   for the turnaround with one EOR.
AI_WEST      equ 4
AI_SOUTHWEST equ 5
AI_SOUTH     equ 6
AI_SOUTHEAST equ 7
AI_NODIR     equ 8
AI_DMAX      equ 14                  ; chasers spr_add can re-attach to the
AIDT_BASE    equ $0E4D                ; ai_dth/ai_dsl/ai_dsh (3 x AI_DMAX): out of
AIDT_END     equ $0E77                ;   the AI block, which had four bytes left.
                                     ;   2026-08-07: was 8, and E1M3's ambush at
                                     ;   (-457,-410) wakes more than that -- the
                                     ;   ones past the table were drawn from
                                     ;   their SPAWN subsector and blinked out
                                     ;   whenever it was off screen ("prechadzaju
                                     ;   za nieco priesvitne, zmiznu, objavia sa")
                                     ;   subsector they WALKED to. The packed
                                     ;   prefix table (pack_things) fixes a thing
                                     ;   to its SPAWN subsector and cannot be
                                     ;   relinked at runtime; past AI_DMAX a
                                     ;   chaser falls back to it and gets a stale
                                     ;   clip window. 8 x 3 B, and spr_add pays
                                     ;   nothing at all while ai_dn is 0.
; ---- reciprocal tables: MOVED to Rapidus bank $01 (2026-07-31) --------------
;   SCALE_TAB/SX_TAB/INV_TAB are 6 x 256 B of pure lookup and were the last
;   contiguous kilobyte-and-a-half in base RAM ($8700-$8CFF). Base RAM had 116 B
;   free and the monster AI needed 908, so the tables went to the bank and the
;   AI took their hole. The cost is one cycle per read (65816 absolute long
;   indexed, `lda.l tab,x`) on a path that runs a few hundred times a frame, and
;   recip_norm hands the index back in X instead of Y because the 65816 has
;   long,X but no long,Y. The DATA still ships in the XEX -- it is assembled
;   into the map slot at RECIP_STAGE and copied up once, before the first level
;   load overwrites that slot (recip_to_ext in bsp_main.asm).
RECIP_EXT     equ $018000            ; bank $01, above the AI pages
RCX_SCALE_LO  equ RECIP_EXT+$000
RCX_SCALE_HI  equ RECIP_EXT+$100
RCX_SX_LO     equ RECIP_EXT+$200
RCX_SX_HI     equ RECIP_EXT+$300
RCX_INV_LO    equ RECIP_EXT+$400
RCX_INV_HI    equ RECIP_EXT+$500
; ...and the sin/cos tables went the same way (2026-07-31). frame_setup is their
; ONLY reader, it already indexes with X, and it only reads them when the view
; angle actually changed -- the coldest kilobyte in the engine. Freed $2800-$2BFF.
TRIG_EXT      equ RECIP_EXT+$600
TRGX_SIN_LO   equ TRIG_EXT+$000
TRGX_SIN_HI   equ TRIG_EXT+$100
TRGX_COS_LO   equ TRIG_EXT+$200
TRGX_COS_HI   equ TRIG_EXT+$300
RECIP_BYTES   equ $0A00              ; 6 reciprocal pages + 4 trig pages
RECIP_STAGE   equ $4000              ; staging: the map slot, dead after the copy
; ---- and the five per-SFX arrays went the same way (2026-08-25) -------------
; sound_tables.inc's arrays are read by snd_play and by NOTHING else: five
; `lda tab,x` in one proc, once per sound STARTED. 280 B of the coldest data in
; the engine -- and it sat at $3DD8, inside a RAPIDUS-FAST window, which is
; exactly what the sight ray's z test needed and what a lookup table does not
; (SGZ_BASE). Same trick as the reciprocals above: the data still ships in the
; XEX, staged into the map slot, copied up by recip_to_ext before the first
; load_level. The order is safe by a mile -- main calls recip_to_ext at $0239,
; load_sounds/snd_init do not run until menu_boot.
SNDX_EXT      equ $019400            ; bank $01, in the free run above DTAB_EXT
SNDX_N        equ 57                 ; = sound_tables.inc SFX_COUNT. It lives HERE
                                     ;   so the five addresses below resolve
                                     ;   before sound.asm is icl'd; sound.asm ERTs
                                     ;   the moment wadsound.py drifts from it --
                                     ;   which is how 56 -> 57 got caught the
                                     ;   minute DSBFG was appended (2026-08-28).
SFX_LO_EXT    equ SNDX_EXT+SNDX_N*0
SFX_HI_EXT    equ SNDX_EXT+SNDX_N*1
SFX_BNK_EXT   equ SNDX_EXT+SNDX_N*2
SFX_NLO_EXT   equ SNDX_EXT+SNDX_N*3
SFX_NHI_EXT   equ SNDX_EXT+SNDX_N*4
SNDX_BYTES    equ SNDX_N*5           ; 280 B. snd_to_ext copies pages THEN the
                                     ;   remainder, so this needs no rounding and
                                     ;   the staging address needs no alignment
; ---- and COLD CODE went the same way (2026-08-26, bank01.asm) --------------
; Not a table this time -- whole PROCEDURES. The 65816 executes out of a Rapidus
; SRAM bank at full speed (the opcode fetch is ExtReadByteAccel(mPC, mK) through
; the PROGRAM bank register and the SRAM layer is FastBus -- alt-src
; h/cpumachine.inl:44, rapidus.cpp:122-125), and bank $01 has ~26 KB free above
; SNDX_EXT. So a cold proc costs 5 bytes of base RAM (a `jsl ... / rts` thunk at
; its old address, which keeps every CALL SITE unchanged) instead of its length.
; The staging slot is $C500-$C7FF, three pages of the THINGS slot that carry no
; XEX segment: it is the gap BETWEEN menu.asm's overlay ($C000-$C4F8) and
; savegame.asm's ($C800-), and load_things is the first thing that ever writes
; it -- long after b1_to_ext has run. Three times RECIP_STAGE's room.
; MEASURE THE RAW XEX, NOT THE SHIPPED ONE, when this needs to grow. The whole
; slot LOOKS empty in build/doom_bsp.xex because split_menu_ovl.py lifts both
; overlays out after the assemble; in the file MADS actually writes they are
; still there, and a block staged over one of them is a second segment at the
; same address -- which that splitter refuses ("expected exactly ONE segment").
; $D800 has the same trap (the automap/finale overlays park there) and so does
; every other hole big enough to be tempting.
B1CODE_OFF    equ $9600              ; offset INSIDE bank $01 (the org address,
                                     ;   so branches/jsr resolve in the bank)
B1CODE_BASE   equ [MAP_EXT_BANK*$10000]  ; ...and what a thunk's `jsl` adds
B1CODE_STAGE  equ $C500              ; staging: the gap between the menu and
                                     ;   savegame overlays in the THINGS slot.
                                     ;   PAGE ALIGNED -- b1_to_ext walks it with
                                     ;   `inc sp_ptr+1` and copies whole pages
B1CODE_MAX    equ $0300              ; 768 B: $C500..$C7FF, and $C800 is where
                                     ;   savegame.asm's overlay parks
B1COPY_BASE   equ $4B9E              ; b1_to_ext: the map slot's tail hole, next
B1COPY_END    equ $4BFF              ;   to recip_to_ext ($4A00) and boot-only
SNDX_COPY     equ $1341              ; snd_to_ext, and SNDX_STAGE right behind it:
SNDX_STAGE    equ $1380              ;   the gap between the end of xdl.asm's
                                     ;   display-list data ($1302-$1340) and the
                                     ;   $1500 code segment -- the tail of TEX_STAGE
                                     ;   plus bsp_stack, 447 B that is dead until
                                     ;   the first SIO call and the first frame
                                     ;   respectively. Both are consumed before
                                     ;   either happens.
                                     ;
                                     ; snd_to_ext sat at $4BB0 for one build and
                                     ; that was WRONG (2026-08-25, "po tom impovi sa
                                     ; neda loadnut save game"): $4BC0 up is wi.asm's
                                     ; variable block (WI_LBLIX..WI_N2), equates with
                                     ; no XEX segment, so neither check_xex nor
                                     ; ram_map can see them -- the exact trap the
                                     ; RAM-BUDGET header warns about. Worse, the map
                                     ; slot is savegame.asm's `$4000, 12 pages`
                                     ; region, so the collision went to disk and came
                                     ; back. CROSS-CHECK build/doom_bsp.lab BEFORE
                                     ; parking anything in a "free" hole.
